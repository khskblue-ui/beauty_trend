{%- set S = gate.sections -%}
{%- macro reduced(name) -%}
<p class="reduced">자료 부족 — {{ S[name].reason }}</p>
{%- endmacro -%}
{%- macro grade(g) -%}{% if g == 'headline' %}<span class="tag">제목·요약 기준</span>{% elif g == 'official' %}<span class="tag tag-off">공식 문서</span>{% endif %}{%- endmacro -%}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cfg.title }} {{ month }}</title>
<style>
:root{--ink:#1d2329;--muted:#5d6670;--line:#dfe3e8;--accent:#2a6f97;--bg:#fff;--soft:#f5f7f9;--warn:#9a5b00;--warnbg:#fff4e0}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.65 "Noto Sans KR","Noto Sans CJK KR","Apple SD Gothic Neo","Malgun Gothic","WenQuanYi Zen Hei",sans-serif;-webkit-font-smoothing:antialiased}
main{max-width:860px;margin:0 auto;padding:32px 20px 64px}
h1{font-size:28px;line-height:1.3;margin:0 0 8px}
h2{font-size:19px;margin:44px 0 12px;padding-bottom:6px;border-bottom:2px solid var(--ink)}
h2 .num{color:var(--accent);margin-right:8px}
h3{font-size:15px;margin:22px 0 8px;color:var(--muted)}
p{margin:6px 0}
a{color:var(--accent)}
.cover{border-bottom:1px solid var(--line);padding-bottom:20px}
.meta{display:grid;grid-template-columns:max-content 1fr;gap:4px 16px;color:var(--muted);font-size:13px;margin-top:14px}
.banner{background:var(--warnbg);color:var(--warn);padding:8px 12px;border-radius:6px;font-size:13px;margin:14px 0}
.summary li{margin:6px 0}
ul.sents{padding-left:18px}ul.sents li{margin:7px 0}
.cite{font-size:11px;margin-left:1px}.cite a{text-decoration:none}
table{width:100%;border-collapse:collapse;font-size:13px;margin:8px 0}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}
th{color:var(--muted);font-weight:600;background:var(--soft)}
td.n,th.n{text-align:right;white-space:nowrap}
.tag{display:inline-block;font-size:11px;padding:0 6px;border-radius:3px;background:var(--soft);color:var(--muted);border:1px solid var(--line);margin-left:4px;white-space:nowrap}
.tag-off{color:var(--accent)}
.reduced{background:var(--soft);border-left:3px solid var(--muted);padding:8px 12px;color:var(--muted);font-size:14px}
.note{color:var(--muted);font-size:12.5px}
.chart{width:100%;height:auto;margin:6px 0}
.chart .grid{stroke:var(--line);stroke-width:1}.chart .tick{font-size:11px;fill:var(--muted)}
.chart .label{font-size:12px;fill:var(--ink)}.chart .bar{fill:var(--accent)}
.sources li{font-size:12px;margin:3px 0;word-break:break-all}
.lk-restricted,.lk-unverified{color:var(--warn);font-size:11px}
@media (max-width:600px){main{padding:20px 16px 48px}h1{font-size:23px}table{font-size:12px}th,td{padding:5px 4px}}
@media print{
  body{font-size:10.5pt}main{max-width:none;padding:0}
  h2{break-after:avoid}table,tr,figure,li{break-inside:avoid}
  .cite a{color:var(--ink)}a{color:var(--ink);text-decoration:none}
  .sources a::after{content:" " attr(href);color:var(--muted)}
  .sources a{word-break:break-all}
}
</style>
</head>
<body>
<main>

<section class="cover">
  <h1>{{ cfg.title }}</h1>
  <div class="meta">
    <span>분석 기간</span><span>{{ agg.month }}-01 ~ {{ agg.month }} 말일(한국 시간)</span>
    <span>자료 기준</span><span>기사·규제 {{ agg.month }} · 네이버 데이터랩 {{ agg.month }}까지(월별 상대값) · 수출입 통계는 아직 싣지 않음</span>
    <span>분석 기사</span><span>{{ agg.counts.docs }}건(같은 내용을 하나로 묶으면 {{ agg.counts.clusters }}건)</span>
    <span>작성</span><span>{{ generated }}</span>
  </div>
  {% if status == 'dry_run' %}<p class="banner">시험본입니다. 수신자에게 보내지 않았습니다.</p>{% endif %}
  {% if status == 'hold' %}<p class="banner">발행 보류본입니다. 핵심 섹션 {{ gate.core_total }}개 중 {{ gate.core_failed }}개가 기준에 못 미쳤습니다.</p>{% endif %}
  {% if not has_prev %}<p class="banner">지난달 자료가 없어 전월 비교는 하지 않았습니다.</p>{% endif %}
</section>

<h2><span class="num">1</span>이달의 요약</h2>
{% if summary %}
<ol class="summary">{% for s in summary %}<li>{{ s.text }}{{ cite(s.doc_ids) }}</li>{% endfor %}</ol>
{% else %}<p class="reduced">출처로 확인된 문장이 없어 요약을 싣지 않았습니다.</p>{% endif %}

<h2><span class="num">2</span>{{ cfg.sections.keywords.title }}</h2>
{% if S.keywords.status == 'ok' %}
<table>
  <thead><tr><th>키워드</th><th class="n">관련 보도</th>{% if agg.keywords.has_prev %}<th class="n">전월</th>{% endif %}<th>근거</th></tr></thead>
  <tbody>
  {% for k in keywords %}
    <tr><td><strong>{{ k.term }}</strong></td><td class="n">{{ k.n_clusters }}</td>{% if agg.keywords.has_prev %}<td class="n">{{ k.n_prev }}</td>{% endif %}
        <td>{% if k.sentence %}{{ k.sentence.text }}{{ cite(k.sentence.doc_ids) }}{% else %}<span class="note">관련 기사:</span> {% for r in k.reps %}{{ r.title }}{{ cite([r.doc_id]) }}{{ " · " if not loop.last }}{% endfor %}{% endif %}</td></tr>
  {% endfor %}
  </tbody>
</table>
<p class="note">관련 보도는 그 키워드를 다룬 기사 수입니다. 같은 내용의 기사가 여러 매체에 실려도 한 건으로 셌습니다.</p>
{% if agg.datalab.search %}
<h3>네이버 검색량 추이 — '{{ agg.datalab.search.anchor }}' 대비</h3>
{{ line_chart(agg.datalab.search.series, agg.datalab.search.anchor) }}
<p class="note">네이버 데이터랩 월별 자료({{ agg.datalab.search.start }} ~ {{ agg.datalab.search.end }})입니다. '{{ agg.datalab.search.anchor }}' 검색량을 1로 놓고 비교한 값이라 실제 검색 횟수는 아닙니다.</p>
{% endif %}
{% else %}{{ reduced('keywords') }}{% endif %}

<h2><span class="num">3</span>{{ cfg.sections.launches.title }}</h2>
{% if agg.launches %}
<table>
  <thead><tr><th>출시일</th><th>브랜드</th><th>제품</th><th>향 노트</th><th>출처</th></tr></thead>
  <tbody>{% for x in agg.launches %}
  <tr><td>{{ x.launch_date }}</td><td>{{ x.brand or '—' }}</td><td>{{ x.name }}{% if x.press_release %}<span class="tag">보도자료</span>{% endif %}</td>
      <td>{{ x.notes|join(', ') if x.notes else '—' }}</td><td>{{ cite([x.doc_id]) }}</td></tr>
  {% endfor %}</tbody>
</table>
{% endif %}
{% if S.launches.status != 'ok' %}{{ reduced('launches') }}{% else %}<p class="note">출시일이 기사로 확인되고 분석 기간 안에 나온 제품만 실었습니다.</p>{% endif %}

<h2><span class="num">4</span>{{ cfg.sections.notes.title }}</h2>
{% if agg.notes.n %}
<p class="note">향 노트를 밝힌 제품 {{ agg.notes.n }}개입니다.{% if agg.notes.n < cfg.sections.notes.chart_min_n %} {{ cfg.sections.notes.chart_min_n }}개가 안 돼 차트 없이 목록만 실었습니다.{% endif %}</p>
{% if agg.notes.n >= cfg.sections.notes.chart_min_n %}{{ bar_chart(agg.notes.note_freq|list, unit='개') }}{% endif %}
<table><thead><tr><th>브랜드</th><th>제품</th><th>노트</th><th>출처</th></tr></thead><tbody>
{% for x in agg.notes['items'] %}<tr><td>{{ x.brand or '—' }}</td><td>{{ x.name }}</td><td>{{ x.notes|join(', ') }}</td><td>{{ cite([x.doc_id]) }}</td></tr>{% endfor %}
</tbody></table>
{% else %}<p class="reduced">이번 달 기사에는 향 노트를 밝힌 제품이 없었습니다.</p>{% endif %}

{% if S.customers.status != 'hidden' %}<h2><span class="num">5</span>{{ cfg.sections.customers.title }}</h2>{% endif %}

<h2><span class="num">6</span>{{ cfg.sections.market.title }}</h2>
<h3>국내</h3>
{% if market.kr %}<ul class="sents">{% for s in market.kr %}<li>{{ s.text }}{{ cite(s.doc_ids) }}</li>{% endfor %}</ul>
{% else %}<p class="reduced">이번 달에는 출처로 확인된 국내 시장 소식이 없습니다.</p>{% endif %}
<h3>해외 <span class="tag">일부는 기사 제목·요약 기준</span></h3>
{% if market['global'] %}<ul class="sents">{% for s in market['global'] %}<li>{{ s.text }}{{ cite(s.doc_ids) }}</li>{% endfor %}</ul>
{% else %}<p class="reduced">이번 달에는 출처로 확인된 해외 시장 소식이 없습니다.</p>{% endif %}
{% if S.market.status != 'ok' %}{{ reduced('market') }}{% endif %}

<h2><span class="num">7</span>{{ cfg.sections.regulation.title }}</h2>
{% set regs = agg.regulation.regulation %}{% set comps = agg.regulation.competitors %}
<h3>규제</h3>
{% if reg.regulation %}<ul class="sents">{% for s in reg.regulation %}<li>{{ s.text }}{{ cite(s.doc_ids) }}</li>{% endfor %}</ul>{% endif %}
{% if regs %}
<table><thead><tr><th>날짜</th><th>기관</th><th>제목</th><th>출처</th></tr></thead><tbody>
{% for c in regs %}<tr><td>{{ c.published }}</td><td>{{ c.source_name }}{{ grade(c.evidence_grade) }}</td><td>{{ c.title }}</td><td>{{ cite(c.doc_ids[:1]) }}</td></tr>{% endfor %}
</tbody></table>
{% else %}<p>변경 없음. EU 화장품 규정, 식약처(보도자료·고시·행정예고), 미국 연방관보(FDA), IFRA에 이번 달 새로 나온 공지가 없습니다.</p>{% endif %}
<h3>경쟁 향료사</h3>
{% if reg.competitors %}<ul class="sents">{% for s in reg.competitors %}<li>{{ s.text }}{{ cite(s.doc_ids) }}</li>{% endfor %}</ul>{% endif %}
{% if comps %}
<table><thead><tr><th>날짜</th><th>회사</th><th>제목</th><th>출처</th></tr></thead><tbody>
{% for c in comps %}<tr><td>{{ c.published }}</td><td>{{ c.source_name }}</td><td>{{ c.title }}</td><td>{{ cite(c.doc_ids[:1]) }}</td></tr>{% endfor %}
</tbody></table>
{% else %}<p>변경 없음. 지보단, 심라이즈, dsm-firmenich의 이번 달 발표가 없습니다. IFF는 사이트 접속이 막혀 빠져 있습니다.</p>{% endif %}
<h3>시행일 일정</h3>
<table><thead><tr><th>날짜</th><th>내용</th></tr></thead><tbody>
{% for c in agg.calendar %}<tr><td>{{ c.date }}</td><td>{{ c.item }} <a href="{{ c.source }}">원문</a></td></tr>{% endfor %}
</tbody></table>

{% if S.signals.status != 'hidden' %}<h2><span class="num">8</span>{{ cfg.sections.signals.title }}</h2>{% endif %}

<h2><span class="num">9</span>부록</h2>
<h3>출처</h3>
<!--SOURCES-->
<h3>수집 현황</h3>
<table><thead><tr><th>출처</th><th class="n">정상 수집일</th><th class="n">실패일</th><th class="n">이달 기사</th><th>최근 오류</th></tr></thead><tbody>
{% for c in coverage %}<tr><td>{{ c.source }}</td><td class="n">{{ c.ok_days }}</td><td class="n">{{ c.fail_days }}</td><td class="n">{{ c.docs_in_month }}</td><td class="note">{{ c.last_error or '' }}</td></tr>{% endfor %}
</tbody></table>
<h3>만든 방법</h3>
<ul class="note">
  <li>국내외 업계지, 네이버 뉴스, 규제기관(EU·식약처·미국 연방관보·IFRA), 경쟁 향료사 발표를 매일 모았습니다. 날짜는 한국 시간 기준입니다.</li>
  <li>기사마다 브랜드·출시일·향 노트를 AI({{ models.enrich.model }})로 뽑고, 뽑은 내용이 원문에 그대로 있는지 프로그램으로 다시 확인했습니다.</li>
  <li>문장은 AI({{ models.write.model }})가 위 기사만 보고 썼으며, 문장마다 출처를 달았습니다. 표와 차트의 숫자는 프로그램이 직접 셌습니다.</li>
  <li>출처와 맞지 않거나 확실하지 않은 문장은 뺐습니다. 이번 호에는 {{ verify_stats.total }}문장 가운데 {{ verify_stats.kept }}문장을 실었습니다.</li>
  <li>소비자 반응과 평가는 다루지 않습니다. 리뷰와 SNS는 수집하지 않습니다.</li>
</ul>
<p class="note">AI가 자동으로 만든 리포트입니다. 자사 제품 포트폴리오는 반영하지 않았습니다. 숫자는 공개 자료의 상대값이므로 중요한 내용은 원문으로 확인하시기 바랍니다.</p>
</main>
</body>
</html>
