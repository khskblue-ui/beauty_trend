{# Shared slides for the motion decks (A/B/C). Same content, each variant styles it.
   Reader-facing copy follows docs/style_guide.md (tests/test_style.py checks it).
   Rows per slide keep every slide inside the 1280×720 canvas. #}
{% set ROWS = 9 %}{% set LIST_ROWS = 6 %}{% set SENTS = 5 %}{# listing titles are long English headlines → fewer rows #}

{% macro slide(title, kicker='', desc='', cls='', page='') -%}
<section class="slide {{ cls }}" data-title="{{ title }}{{ page }}">
  <header class="s-head">{% if kicker %}<div class="s-kicker">{{ kicker }}</div>{% endif %}
    <h2 class="rv">{{ title }}{% if page %}<span class="s-page">{{ page }}</span>{% endif %}</h2>
    {% if desc %}<p class="s-desc rv">{{ desc }}</p>{% endif %}</header>
  <div class="s-body">{{ caller() }}</div>
  <footer class="s-foot"><span>{{ cfg.title }} {{ period.tag }}</span><span class="s-num"></span></footer>
</section>
{%- endmacro %}

{% macro pg(loop) -%}{% if loop.length > 1 %} ({{ loop.index }}/{{ loop.length }}){% endif %}{%- endmacro %}

{% macro sents(items, empty) -%}
{% if items %}<ul class="sents">{% for s in items %}<li class="rv" style="--i:{{ loop.index0 }}">{{ s.text }}{{ cite(s.doc_ids) }}</li>{% endfor %}</ul>
{% else %}<p class="reduced rv">{{ empty }}</p>{% endif %}
{%- endmacro %}

{% macro reduced(name) -%}
{% if gate.sections[name].status == 'reduced' %}<p class="reduced rv">자료가 적습니다. {{ gate.sections[name].reason }}</p>{% endif %}
{%- endmacro %}

{% macro kw_explain(k) -%}
{% if k.sentence %}{{ k.sentence.text }}{{ cite(k.sentence.doc_ids) }}
{%- else %}<span class="reps">관련 기사: {% for r in k.reps %}{{ r.title }}{{ cite([r.doc_id]) }}{{ ', ' if not loop.last }}{% endfor %}</span>{% endif %}
{%- endmacro %}

{% macro banners() -%}
{% if status == 'dry_run' %}<p class="banner">시험본입니다. 수신자에게 보내지 않았습니다.</p>{% endif %}
{% if status == 'hold' %}<p class="banner">발행 보류: 핵심 섹션 {{ gate.core_total }}개 중 {{ gate.core_failed }}개가 기준에 못 미칩니다</p>{% endif %}
{% if not has_prev %}<p class="banner">지난달 자료가 없어 전월 비교는 하지 않았습니다</p>{% endif %}
{%- endmacro %}

{# ---------- slides ---------- #}

{% macro summary_slide(kicker) -%}
{% call slide('이달의 요약', kicker, '키워드, 시장, 규제에서 한 줄씩 골랐습니다.', 'sl-summary') %}
{% if summary %}<ol class="summary">{% for s in summary %}<li class="rv" style="--i:{{ loop.index0 }}"><span>{{ s.text }}{{ cite(s.doc_ids) }}</span></li>{% endfor %}</ol>
{% else %}<p class="reduced">출처로 확인된 문장이 없어 요약을 싣지 않았습니다.</p>{% endif %}
{% endcall %}
{%- endmacro %}

{% macro datalab_method() -%}
집계 방법: 네이버 데이터랩 검색어 트렌드에 키워드와 '{{ viz.search.anchor }}'를 한 번에 넣어 월별 검색량 지수(PC와 모바일 합계, 모든 연령과 성별)를 받고, 각 달의 키워드 지수를 같은 달 '{{ viz.search.anchor }}' 지수로 나눴습니다. 1이면 '{{ viz.search.anchor }}'만큼 검색됐다는 뜻입니다. 기간은 {{ viz.search.series[viz.search.anchor][0][0] }} ~ {{ period.end }}{% if period.interim %}이고, {{ period.end[5:7]|int }}월은 {{ period.end[8:]|int }}일까지만 셌습니다{% endif %}.
{%- endmacro %}

{% macro search_slide(kicker, colors) -%}
{% if viz.search %}{% set g = line_paths(viz.search.series, viz.search.anchor, 1100, 400, (56, 16, 30, 150), 22) %}
{% call slide("네이버 검색량 추이", kicker, "'" ~ viz.search.anchor ~ "' 검색량을 1로 놓고 비교한 월별 값입니다. 실제 검색 횟수는 아닙니다.", 'sl-search') %}
<figure class="chart-wrap rv">
  <svg class="chart" viewBox="0 0 {{ g.width }} {{ g.height }}" role="img" aria-label="키워드별 네이버 검색량 추이(상대값)">
    {% for t in g.ticks %}<line class="grid" x1="{{ g.x0 }}" x2="{{ g.x1 }}" y1="{{ '%.1f'|format(t.y) }}" y2="{{ '%.1f'|format(t.y) }}"/><text class="tick" x="{{ g.x0 - 8 }}" y="{{ '%.1f'|format(t.y + 4) }}" text-anchor="end">{{ t.v }}</text>{% endfor %}
    {% for p in g.periods %}<text class="tick" x="{{ '%.1f'|format(p.x) }}" y="{{ g.height - 6 }}" text-anchor="middle">{{ p.p }}</text>{% endfor %}
    {% for l in g.lines %}<path class="draw" d="{{ l.d }}" stroke="{{ colors[loop.index0 % colors|length] }}"/>
    <text class="lbl" x="{{ '%.1f'|format(l.end[0] + 10) }}" y="{{ '%.1f'|format(l.label_y + 5) }}" fill="{{ colors[loop.index0 % colors|length] }}">{{ l.term }}</text>{% endfor %}
  </svg>
  <figcaption class="note">{{ datalab_method() }}</figcaption>
</figure>
{% endcall %}
{% endif %}
{%- endmacro %}

{% macro notes_table_slides(kicker) -%}
{% if agg.notes.n %}
{% for chunk in agg.notes['items']|batch(ROWS) %}
{% call slide('향 노트를 밝힌 제품', kicker, '' if not loop.first else '같은 제품을 다룬 기사가 여럿이어도 한 번만 실었습니다.', 'sl-table', pg(loop)) %}
<table class="rv"><thead><tr><th>브랜드</th><th>제품</th><th>향 노트</th><th class="c">출처</th></tr></thead><tbody>
{% for x in chunk %}<tr><td>{{ x.brand or '-' }}</td><td>{{ x.name }}</td><td>{{ x.notes|join(', ') }}</td><td class="c">{{ cite([x.doc_id]) }}</td></tr>{% endfor %}
</tbody></table>
{% endcall %}
{% endfor %}
{% endif %}
{%- endmacro %}

{% macro launch_slides(kicker) -%}
{% set items = agg.launches %}
{% for chunk in (items|batch(ROWS)|list or [[]]) %}
{% call slide('신제품 출시', kicker, '분석 기간에 출시됐다고 기사로 확인된 제품입니다. 날짜 옆 * 표시는 기사에 출시일이 없어 기사 게재일을 적은 것입니다.' if loop.first else '', 'sl-table', pg(loop)) %}
{% if chunk %}<table class="rv"><thead><tr><th>출시일</th><th>브랜드</th><th>제품</th><th>향 노트</th><th class="c">출처</th></tr></thead><tbody>
{% for x in chunk %}<tr><td class="mono">{{ x.launch_date }}{% if x.date_basis == 'published' %}*{% endif %}</td><td>{{ x.brand or '-' }}</td><td>{{ x.name }}{% if x.press_release %} <span class="tag">보도자료</span>{% endif %}</td><td>{{ x.notes|join(', ') if x.notes else '-' }}</td><td class="c">{{ cite([x.doc_id]) }}</td></tr>{% endfor %}
</tbody></table>{% endif %}
{% if loop.last %}{{ reduced('launches') }}{% endif %}
{% endcall %}
{% endfor %}
{%- endmacro %}

{% macro market_slides(kicker) -%}
{% set kr = market.kr %}{% set gl = market['global'] %}
{% if kr|length + gl|length <= SENTS %}
{% call slide('시장 동향', kicker, '국내와 해외 소식입니다. 해외 소식 일부는 기사 제목과 요약만 확인했습니다.', 'sl-market') %}
<h3 class="rv">국내</h3>{{ sents(kr, '분석 기간에는 출처로 확인된 국내 시장 소식이 없습니다.') }}
<h3 class="rv">해외</h3>{{ sents(gl, '분석 기간에는 출처로 확인된 해외 시장 소식이 없습니다.') }}
{% endcall %}
{% else %}
{% call slide('국내 시장 동향', kicker, '', 'sl-market') %}{{ sents(kr, '분석 기간에는 출처로 확인된 국내 시장 소식이 없습니다.') }}{% endcall %}
{% call slide('해외 시장 동향', kicker, '일부는 기사 제목과 요약만 확인했습니다.', 'sl-market') %}{{ sents(gl, '분석 기간에는 출처로 확인된 해외 시장 소식이 없습니다.') }}{% endcall %}
{% endif %}
{{ reduced('market') if gate.sections.market.status == 'reduced' }}
{%- endmacro %}

{% macro listing_slides(title, kicker, sentences, rows, col2, empty) -%}
{% if sentences %}
{% call slide(title, kicker, '', 'sl-market') %}{{ sents(sentences, '') }}{% endcall %}
{% endif %}
{% for chunk in (rows|batch(LIST_ROWS)|list or [[]]) %}
{% call slide(title ~ ' 목록' if sentences else title, kicker, '', 'sl-table', pg(loop)) %}
{% if chunk %}<table class="rv"><thead><tr><th>날짜</th><th>{{ col2 }}</th><th>제목</th><th class="c">출처</th></tr></thead><tbody>
{% for c in chunk %}<tr><td class="mono">{{ c.published }}</td><td>{{ c.source_name }}</td><td>{{ c.title }}</td><td class="c">{{ cite(c.doc_ids[:1]) }}</td></tr>{% endfor %}
</tbody></table>
{% else %}<p class="rv empty">{{ empty }}</p>{% endif %}
{% endcall %}
{% endfor %}
{%- endmacro %}

{% macro reg_slides(kicker) -%}
{{ listing_slides('규제', kicker, reg.regulation, agg.regulation.regulation, '기관',
   '변경 없음. 식약처, EU 화장품 규정, 미국 연방관보(FDA)에 분석 기간 새로 나온 공시가 없습니다.') }}
{%- endmacro %}

{% macro calendar_slide(kicker) -%}
{% call slide('시행일 일정', kicker, '이미 정해진 규제 기한입니다.', 'sl-cal') %}
<ul class="cal">{% for c in viz.calendar %}<li class="rv"><span class="mono">{{ c.date }}</span><span>{{ c.item }}{% if c.days_left is defined %}, {{ c.days_left }}일 남음{% endif %} <a href="{{ c.source }}" target="_blank" rel="noopener">원문</a></span></li>{% endfor %}</ul>
{% endcall %}
{%- endmacro %}

{% macro deck_ui() -%}
<nav class="deck-ui" aria-label="슬라이드 이동"><div class="bar"></div>
  <button class="prev" type="button" aria-label="이전 슬라이드"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
  <span class="count" aria-live="polite">1 / 1</span>
  <button class="next" type="button" aria-label="다음 슬라이드"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
  <span class="hint">← → 키로 넘깁니다</span>
</nav>
{%- endmacro %}
