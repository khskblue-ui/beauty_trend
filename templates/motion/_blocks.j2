{# Content blocks shared by all motion variants. Same content, different staging.
   Reader-facing copy follows docs/style_guide.md (tests/test_style.py checks it). #}
{% macro sents(items, empty) -%}
{% if items %}<ul class="sents">{% for s in items %}<li class="rv">{{ s.text }}{{ cite(s.doc_ids) }}</li>{% endfor %}</ul>
{% else %}<p class="reduced rv">{{ empty }}</p>{% endif %}
{%- endmacro %}

{% macro reduced(name) -%}
{% if gate.sections[name].status == 'reduced' %}<p class="reduced rv">자료 부족 — {{ gate.sections[name].reason }}</p>{% endif %}
{%- endmacro %}

{% macro summary_list() -%}
{% if summary %}<ol class="summary">{% for s in summary %}<li class="rv"><span>{{ s.text }}{{ cite(s.doc_ids) }}</span></li>{% endfor %}</ol>
{% else %}<p class="reduced">출처로 확인된 문장이 없어 요약을 싣지 않았습니다.</p>{% endif %}
{%- endmacro %}

{% macro kw_explain(k) -%}
{% if k.sentence %}{{ k.sentence.text }}{{ cite(k.sentence.doc_ids) }}
{%- else %}<span class="reps">관련 기사: {% for r in k.reps %}{{ r.title }}{{ cite([r.doc_id]) }}{{ ' · ' if not loop.last }}{% endfor %}</span>{% endif %}
{%- endmacro %}

{% macro launches_table() -%}
{% if agg.launches %}<div class="tw rv"><table><thead><tr><th>출시일</th><th>브랜드</th><th>제품</th><th>향 노트</th><th>출처</th></tr></thead><tbody>
{% for x in agg.launches %}<tr><td class="mono">{{ x.launch_date }}</td><td>{{ x.brand or '—' }}</td><td>{{ x.name }}{% if x.press_release %} <span class="tag">보도자료</span>{% endif %}</td><td>{{ x.notes|join(', ') if x.notes else '—' }}</td><td>{{ cite([x.doc_id]) }}</td></tr>{% endfor %}
</tbody></table></div>{% endif %}
{{ reduced('launches') }}
{%- endmacro %}

{% macro notes_table() -%}
{% if agg.notes.n %}<div class="tw rv"><table><thead><tr><th>브랜드</th><th>제품</th><th>향 노트</th><th>출처</th></tr></thead><tbody>
{% for x in agg.notes['items'] %}<tr><td>{{ x.brand or '—' }}</td><td>{{ x.name }}</td><td>{{ x.notes|join(', ') }}</td><td>{{ cite([x.doc_id]) }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="reduced">이번 달 기사에는 향 노트를 밝힌 제품이 없었습니다.</p>{% endif %}
{%- endmacro %}

{% macro reg_tables() -%}
{% set regs = agg.regulation.regulation %}{% set comps = agg.regulation.competitors %}
<h3 class="rv">규제</h3>
{{ sents(reg.regulation, '') if reg.regulation }}
{% if regs %}<div class="tw rv"><table><thead><tr><th>날짜</th><th>기관</th><th>제목</th><th>출처</th></tr></thead><tbody>
{% for c in regs %}<tr><td class="mono">{{ c.published }}</td><td>{{ c.source_name }}</td><td>{{ c.title }}</td><td>{{ cite(c.doc_ids[:1]) }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="rv">변경 없음. EU 화장품 규정, 식약처, 미국 연방관보(FDA), IFRA에 이번 달 새로 나온 공지가 없습니다.</p>{% endif %}
<h3 class="rv">경쟁 향료사</h3>
{{ sents(reg.competitors, '') if reg.competitors }}
{% if comps %}<div class="tw rv"><table><thead><tr><th>날짜</th><th>회사</th><th>제목</th><th>출처</th></tr></thead><tbody>
{% for c in comps %}<tr><td class="mono">{{ c.published }}</td><td>{{ c.source_name }}</td><td>{{ c.title }}</td><td>{{ cite(c.doc_ids[:1]) }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="rv">변경 없음. 지보단, 심라이즈, dsm-firmenich의 이번 달 발표가 없습니다. IFF는 사이트 접속이 막혀 빠져 있습니다.</p>{% endif %}
<h3 class="rv">시행일 일정</h3>
<ul class="cal">{% for c in agg.calendar %}<li class="rv"><span class="mono">{{ c.date }}</span> {{ c.item }} <a href="{{ c.source }}">원문</a></li>{% endfor %}</ul>
{%- endmacro %}

{% macro appendix() -%}
<h3>출처</h3>
<!--SOURCES-->
<h3>수집 현황</h3>
<div class="tw"><table><thead><tr><th>출처</th><th class="n">정상 수집일</th><th class="n">실패일</th><th class="n">이달 기사</th></tr></thead><tbody>
{% for c in coverage %}<tr><td>{{ c.source }}</td><td class="n mono">{{ c.ok_days }}</td><td class="n mono">{{ c.fail_days }}</td><td class="n mono">{{ c.docs_in_month }}</td></tr>{% endfor %}
</tbody></table></div>
<h3>만든 방법</h3>
<ul class="fine">
  <li>국내외 업계지, 네이버 뉴스, 규제기관(EU·식약처·미국 연방관보·IFRA), 경쟁 향료사 발표를 매일 모았습니다. 날짜는 한국 시간 기준입니다.</li>
  <li>기사마다 브랜드·출시일·향 노트를 AI({{ models.enrich.model }})로 뽑고, 뽑은 내용이 원문에 그대로 있는지 프로그램으로 다시 확인했습니다.</li>
  <li>문장은 AI({{ models.write.model }})가 위 기사만 보고 썼으며, 문장마다 출처를 달았습니다. 표와 차트의 숫자는 프로그램이 직접 셌습니다.</li>
  <li>출처와 맞지 않거나 확실하지 않은 문장은 뺐습니다. 이번 호에는 {{ verify_stats.total }}문장 가운데 {{ verify_stats.kept }}문장을 실었습니다.</li>
  <li>소비자 반응과 평가는 다루지 않습니다. 리뷰와 SNS는 수집하지 않습니다.</li>
</ul>
<p class="fine">AI가 자동으로 만든 리포트입니다. 자사 제품 포트폴리오는 반영하지 않았습니다.</p>
{%- endmacro %}

{% macro banners() -%}
{% if status == 'dry_run' %}<p class="banner">시험본 — 수신자에게 보내지 않았습니다</p>{% endif %}
{% if status == 'hold' %}<p class="banner">발행 보류 — 핵심 섹션 {{ gate.core_total }}개 중 {{ gate.core_failed }}개가 기준에 못 미칩니다</p>{% endif %}
{% if not has_prev %}<p class="banner">지난달 자료가 없어 전월 비교는 하지 않았습니다</p>{% endif %}
{%- endmacro %}
