{# Content blocks shared by all motion variants. Same verified content, different staging. #}
{% macro sents(items, empty) -%}
{% if items %}<ul class="sents">{% for s in items %}<li class="rv">{{ s.text }}{{ cite(s.doc_ids) }}</li>{% endfor %}</ul>
{% else %}<p class="reduced rv">{{ empty }}</p>{% endif %}
{%- endmacro %}

{% macro reduced(name) -%}
{% if gate.sections[name].status == 'reduced' %}<p class="reduced rv">데이터 부족 — {{ gate.sections[name].reason }}</p>{% endif %}
{%- endmacro %}

{% macro summary_list() -%}
{% if summary %}<ol class="summary">{% for s in summary %}<li class="rv"><span>{{ s.text }}{{ cite(s.doc_ids) }}</span></li>{% endfor %}</ol>
{% else %}<p class="reduced">검증을 통과한 문장이 없어 요약을 생략했습니다.</p>{% endif %}
{%- endmacro %}

{% macro keyword_rows() -%}
{% for k in keywords %}<li class="kw rv"><strong>{{ k.term }}</strong><span class="kwn">근거 사건 <b>{{ k.n_clusters }}</b>건{% if agg.keywords.has_prev %} · 전월 {{ k.n_prev }}건{% endif %}</span><p>{{ k.sentence.text }}{{ cite(k.sentence.doc_ids) }}</p></li>{% endfor %}
{%- endmacro %}

{% macro launches_table() -%}
{% if agg.launches %}<div class="tw rv"><table><thead><tr><th>출시일</th><th>브랜드</th><th>제품</th><th>명시된 노트</th><th>출처</th></tr></thead><tbody>
{% for x in agg.launches %}<tr><td class="mono">{{ x.launch_date }}</td><td>{{ x.brand or '—' }}</td><td>{{ x.name }}{% if x.press_release %} <span class="tag">보도자료</span>{% endif %}</td><td>{{ x.notes|join(', ') if x.notes else '—' }}</td><td>{{ cite([x.doc_id]) }}</td></tr>{% endfor %}
</tbody></table></div>{% endif %}
{{ reduced('launches') }}
{%- endmacro %}

{% macro notes_table() -%}
{% if agg.notes.n %}<div class="tw rv"><table><thead><tr><th>브랜드</th><th>제품</th><th>노트</th><th>출처</th></tr></thead><tbody>
{% for x in agg.notes['items'] %}<tr><td>{{ x.brand or '—' }}</td><td>{{ x.name }}</td><td>{{ x.notes|join(', ') }}</td><td>{{ cite([x.doc_id]) }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="reduced">이번 달 기사에서 향 노트가 명시된 제품을 찾지 못했습니다(n=0).</p>{% endif %}
{%- endmacro %}

{% macro reg_tables() -%}
{% set regs = agg.regulation.regulation %}{% set comps = agg.regulation.competitors %}
<h3 class="rv">규제</h3>
{{ sents(reg.regulation, '') if reg.regulation }}
{% if regs %}<div class="tw rv"><table><thead><tr><th>날짜</th><th>기관</th><th>제목</th><th>출처</th></tr></thead><tbody>
{% for c in regs %}<tr><td class="mono">{{ c.published }}</td><td>{{ c.source_name }}</td><td>{{ c.title }}</td><td>{{ cite(c.doc_ids[:1]) }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="rv">변경 없음 — EU 화장품 규정 개정, 식약처, Federal Register(FDA), IFRA에서 이번 달 신규 항목이 없었습니다.</p>{% endif %}
<h3 class="rv">경쟁 향료사</h3>
{{ sents(reg.competitors, '') if reg.competitors }}
{% if comps %}<div class="tw rv"><table><thead><tr><th>날짜</th><th>회사</th><th>제목</th><th>출처</th></tr></thead><tbody>
{% for c in comps %}<tr><td class="mono">{{ c.published }}</td><td>{{ c.source_name }}</td><td>{{ c.title }}</td><td>{{ cite(c.doc_ids[:1]) }}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="rv">변경 없음 (IFF는 수집 차단으로 미포함)</p>{% endif %}
<h3 class="rv">시행일 캘린더</h3>
<ul class="cal">{% for c in agg.calendar %}<li class="rv"><span class="mono">{{ c.date }}</span> {{ c.item }} <a href="{{ c.source }}">원문</a></li>{% endfor %}</ul>
{%- endmacro %}

{% macro appendix() -%}
<h3>출처</h3>
<!--SOURCES-->
<h3>데이터 커버리지</h3>
<div class="tw"><table><thead><tr><th>소스</th><th class="n">성공 일수</th><th class="n">실패 일수</th><th class="n">기간 내 기사</th></tr></thead><tbody>
{% for c in coverage %}<tr><td>{{ c.source }}</td><td class="n mono">{{ c.ok_days }}</td><td class="n mono">{{ c.fail_days }}</td><td class="n mono">{{ c.docs_in_month }}</td></tr>{% endfor %}
</tbody></table></div>
<h3>방법론</h3>
<ul class="fine">
  <li>업계지·글로벌 업계지 RSS, 네이버 뉴스 검색, 규제기관(EU CELLAR·식약처·Federal Register·IFRA), 경쟁 향료사 발표를 매일 수집(KST).</li>
  <li>기사별 추출: {{ models.enrich.model }}. 원문 인용이 기사에 그대로 있는지 코드로 확인.</li>
  <li>문장 작성: {{ models.write.model }}. 근거 카드만 사용, 문장마다 출처. 숫자는 코드가 계산한 값만 표·차트에 표시.</li>
  <li>검증: 인용 일치·숫자 미포함·엔티티 일치·근거 함의(별도 판정, 불확실하면 삭제). 이번 호 {{ verify_stats.total }}문장 중 {{ verify_stats.kept }}문장 게재.</li>
  <li>소비자 반응·호평은 다루지 않습니다(리뷰·SNS 미수집).</li>
</ul>
<p class="fine">AI가 자동 생성한 리포트이며 자사 포트폴리오 정보는 반영되지 않았습니다.</p>
{%- endmacro %}

{% macro banners() -%}
{% if status == 'dry_run' %}<p class="banner">드라이런 결과물 — 수신자에게 발송되지 않음</p>{% endif %}
{% if status == 'hold' %}<p class="banner">품질 게이트 미달로 발행 보류(핵심 섹션 {{ gate.core_failed }}/{{ gate.core_total }} 미달)</p>{% endif %}
{% if not has_prev %}<p class="banner">전월 데이터가 없어 전월 대비 비교를 하지 않았습니다</p>{% endif %}
{%- endmacro %}
