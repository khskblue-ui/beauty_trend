{% import "motion/_blocks.j2" as b with context %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ month }} Chromatogram — {{ cfg.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#FAFAF7; --ink:#0F1A16; --muted:#4F5B56; --grid:#E3E6E0; --grid-2:#EEF0EB;
  --trace:#0B6E4F; --hot:#B5532E; --panel:#FFFFFF;
  --sans:"Noto Sans KR","Apple SD Gothic Neo","Malgun Gothic","WenQuanYi Zen Hei",sans-serif;
  --mono:"JetBrains Mono",ui-monospace,monospace;
  --ease:cubic-bezier(.3,.7,0,1);
}
*{box-sizing:border-box}
body{word-break:keep-all;overflow-wrap:anywhere}
body{margin:0;color:var(--ink);font:15.5px/1.7 var(--sans);-webkit-font-smoothing:antialiased;
  background-color:var(--bg);
  background-image:linear-gradient(var(--grid-2) 1px,transparent 1px),linear-gradient(90deg,var(--grid-2) 1px,transparent 1px);
  background-size:24px 24px}
a{color:inherit}
a:focus-visible{outline:2px solid var(--hot);outline-offset:2px}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
.mono{font-family:var(--mono)}

/* run label (instrument header) */
.runlabel{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1.5px solid var(--ink);background:var(--panel);margin-top:28px}
.runlabel div{padding:10px 12px;border-right:1px solid var(--grid)}
.runlabel div:last-child{border-right:0}
.runlabel span{display:block;font:500 12px/1.4 var(--sans);color:var(--muted)}
.runlabel b{font:600 15px/1.4 var(--mono)}
h1{font:700 clamp(30px,4.4vw,52px)/1.18 var(--sans);letter-spacing:-.02em;margin:36px 0 8px;max-width:18em}
.sub{color:var(--muted);margin:0 0 6px;max-width:44em}
.banner{display:inline-block;margin:10px 8px 0 0;padding:2px 8px;font:12.5px var(--sans);background:var(--panel);border:1px solid var(--grid)}

/* chromatogram */
.gc{background:var(--panel);border:1.5px solid var(--ink);margin:26px 0 8px;padding:10px 10px 0}
.gc svg{width:100%;height:auto;display:block}
.gc .axis{stroke:var(--ink);stroke-width:1.2}
.gc .tick{font:10.5px var(--mono);fill:var(--muted)}
.gc .trace{fill:none;stroke:var(--trace);stroke-width:1.8;stroke-linejoin:round}
.gc .fillarea{fill:color-mix(in srgb,var(--trace) 10%,transparent)}
.gc .cursor{stroke:var(--hot);stroke-width:1.2;stroke-dasharray:3 3}
.gc .pk text{font:600 13px var(--sans);fill:var(--ink)}
.gc .pk .n{font:500 11px var(--mono);fill:var(--hot)}
.gc .pk line{stroke:var(--ink);stroke-width:.8}
.motion .gc .trace{stroke-dasharray:var(--len);stroke-dashoffset:var(--len)}
.motion .gc.in .trace{animation:trace 2.4s linear forwards}
@keyframes trace{to{stroke-dashoffset:0}}
.motion .gc .fillarea{opacity:0}
.motion .gc.in .fillarea{animation:fade .8s ease 2.4s forwards}
@keyframes fade{to{opacity:1}}
.motion .gc .cursor{opacity:0}
.motion .gc.in .cursor{animation:sweep 2.4s linear forwards}
@keyframes sweep{0%{opacity:1;transform:translateX(0)}99%{opacity:1}100%{opacity:0;transform:translateX(var(--span))}}
.motion .gc .pk{opacity:0;transform:translateY(6px)}
.motion .gc.in .pk{animation:pk .5s var(--ease) forwards;animation-delay:var(--delay)}
@keyframes pk{to{opacity:1;transform:none}}
.gc figcaption{font-size:12.5px;color:var(--muted);padding:8px 4px 10px;border-top:1px solid var(--grid);margin-top:4px}

/* sections as "fractions" */
.frac{display:grid;grid-template-columns:120px 1fr;gap:28px;padding:54px 0 10px}
.frac-id{font:700 12px/1.5 var(--mono);color:var(--muted)}
.frac-id b{display:block;font:700 30px/1.1 var(--mono);color:var(--trace);letter-spacing:-.02em}
.frac h2{font:700 26px/1.3 var(--sans);margin:0 0 6px;letter-spacing:-.01em}
.frac .desc{color:var(--muted);font-size:14px;margin:0 0 20px}
h3{font:600 14px/1.4 var(--sans);letter-spacing:0;color:var(--muted);margin:30px 0 10px}

.motion .rv{opacity:0;transform:translateX(-10px);transition:opacity .6s var(--ease),transform .8s var(--ease)}
.motion .rv.in{opacity:1;transform:none}

.summary{list-style:none;margin:0;padding:0;counter-reset:s}
.summary li{counter-increment:s;display:grid;grid-template-columns:58px 1fr;align-items:baseline;padding:14px 16px;background:var(--panel);border:1px solid var(--grid);margin-bottom:8px;font-size:17px}
.summary li::before{content:"RT " counter(s,decimal-leading-zero);font:600 11px var(--mono);color:var(--trace)}

/* mass spectrum for notes */
.ms{background:var(--panel);border:1px solid var(--grid);padding:14px 14px 6px}
.ms ul{list-style:none;margin:0;padding:0}
.ms li{display:grid;grid-template-columns:120px 1fr 40px;gap:10px;align-items:center;height:26px}
.ms .nm{font-size:13.5px;text-align:right}
.ms .stick{position:relative;height:100%}
.ms .stick::before{content:"";position:absolute;left:0;top:50%;height:1.5px;width:calc(var(--w) * 100%);background:var(--ink);transform-origin:left}
.ms .stick::after{content:"";position:absolute;top:calc(50% - 4px);left:calc(var(--w) * 100% - 4px);width:8px;height:8px;border-radius:50%;background:var(--hot)}
.motion .ms .stick::before{transform:scaleX(0);transition:transform 1.1s var(--ease)}
.motion .ms .stick::after{opacity:0;transition:opacity .3s ease 1s}
.motion .ms.in .stick::before{transform:scaleX(1)}
.motion .ms.in .stick::after{opacity:1}
.ms .ct{font:12px var(--mono);color:var(--muted)}

/* specimen labels for products */
.specimens{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:10px;list-style:none;margin:12px 0 0;padding:0}
.spec{background:var(--panel);border:1px solid var(--ink);padding:10px 12px;font-size:13.5px}
.spec dl{display:grid;grid-template-columns:62px 1fr;gap:2px 8px;margin:0}
.spec dt{font:500 12px/1.75 var(--sans);color:var(--muted)}
.spec dd{margin:0}
.spec .ref{font:500 11px var(--mono)}

/* detector channels for search index */
.channels{display:grid;gap:8px}
.ch{display:grid;grid-template-columns:130px 1fr 70px;gap:10px;align-items:center;background:var(--panel);border:1px solid var(--grid);padding:6px 10px}
.ch .nm{font:600 13.5px var(--sans)}
.ch svg{width:100%;height:42px;display:block}
.ch path.draw{fill:none;stroke:var(--trace);stroke-width:1.8}
.motion .ch path.draw{stroke-dasharray:var(--len);stroke-dashoffset:var(--len);transition:stroke-dashoffset 1.6s var(--ease)}
.motion .ch.in path.draw{stroke-dashoffset:0}
.ch .v{font:600 13px var(--mono);text-align:right}
.ch .v small{display:block;font:10.5px var(--mono);color:var(--muted);font-weight:400}

ul.sents{margin:0;padding:0;list-style:none}
ul.sents li{padding:10px 0 10px 22px;position:relative;border-bottom:1px solid var(--grid)}
ul.sents li::before{content:"▸";position:absolute;left:4px;top:10px;color:var(--trace);font-size:12px}
.cite{font:500 10.5px/1 var(--mono);margin-left:2px}.cite a{text-decoration:none;color:var(--hot)}
.tw{overflow-x:auto;background:var(--panel)}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--grid);vertical-align:top}
th{font:600 10.5px var(--mono);letter-spacing:.08em;color:var(--muted);text-transform:uppercase}
td.n,th.n{text-align:right}
.tag{font:10.5px var(--mono);padding:0 5px;border:1px solid var(--grid);white-space:nowrap}
.reduced{font:14px/1.6 var(--sans);color:var(--muted);background:var(--panel);border:1px dashed var(--muted);padding:10px 12px}
.cal{list-style:none;padding:0;margin:0}.cal li{padding:8px 0;border-bottom:1px solid var(--grid)}
.note{font-size:12.5px;color:var(--muted)}
.fine{font-size:13px;color:var(--muted);padding-left:18px}
.sources{font-size:12.5px;padding-left:22px;word-break:break-all}.sources li{margin:4px 0}
.lk-restricted,.lk-unverified{color:var(--hot);font-size:11px}
footer{padding:40px 0 70px}

@media (max-width:820px){
  .runlabel{grid-template-columns:1fr 1fr}
  .runlabel div:nth-child(2){border-right:0}
  .runlabel div:nth-child(-n+2){border-bottom:1px solid var(--grid)}
  .frac{grid-template-columns:1fr;gap:6px}
  .ms li{grid-template-columns:84px 1fr 34px}
  .ch{grid-template-columns:90px 1fr 56px}
}
@media print{
  body{background-image:none}
  .rv,.pk,.fillarea{opacity:1!important;transform:none!important;animation:none!important}
  .trace,path.draw{stroke-dashoffset:0!important;animation:none!important}
  .cursor{display:none}
  .ms .stick::before{transform:none!important}.ms .stick::after{opacity:1!important}
}
</style>
<script>/* set before first paint so start states render, then animate */if(!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)&&'IntersectionObserver' in window)document.documentElement.classList.add('motion')</script>
</head>
<body>
<header class="wrap">
  <div class="runlabel">
    <div><span>분석 월</span><b>{{ month }}</b></div>
    <div><span>분석 기사</span><b data-count="{{ agg.counts.docs }}">{{ agg.counts.docs }}</b></div>
    <div><span>같은 내용을 묶은 보도</span><b data-count="{{ agg.counts.clusters }}">{{ agg.counts.clusters }}</b></div>
    <div><span>작성</span><b>{{ generated[:16] }}</b></div>
  </div>
  <h1>{{ month[5:]|int }}월 업계 기사에서 두드러진 키워드</h1>
  <p class="sub">향료 성분 분석에 쓰는 크로마토그램처럼 그렸습니다. 봉우리 하나가 키워드 하나이고, 높이는 그 키워드를 다룬 보도 수입니다. 분석 기간 {{ month }}-01 ~ 말일(한국 시간), 네이버 데이터랩 {{ month }}까지, 수출입 통계는 아직 싣지 않음.</p>
  {{ b.banners() }}

  {% set gc = chromatogram(viz.keywords, 960, 280) %}
  <figure class="gc stage" style="--span:{{ gc.right - gc.left }}px">
    <svg viewBox="0 0 {{ gc.width }} {{ gc.height }}" role="img"
         aria-label="키워드별 보도 수: {% for p in gc.peaks %}{{ p.term }} {{ p.n }}건{{ ', ' if not loop.last }}{% endfor %}">
      {% if gc.peaks %}
      <path class="fillarea" d="{{ gc.d }} L{{ gc.right }},{{ gc.base }} L{{ gc.left }},{{ gc.base }} Z"/>
      <path class="trace draw" d="{{ gc.d }}"/>
      <line class="axis" x1="{{ gc.left }}" x2="{{ gc.right }}" y1="{{ gc.base + 1 }}" y2="{{ gc.base + 1 }}"/>
      {% for i in range(0, 11) %}{% set x = gc.left + (gc.right - gc.left) * i / 10 %}
        <line class="axis" x1="{{ '%.1f'|format(x) }}" x2="{{ '%.1f'|format(x) }}" y1="{{ gc.base + 1 }}" y2="{{ gc.base + 6 }}"/>
      {% endfor %}
      <text class="tick" x="{{ gc.right }}" y="{{ gc.base + 22 }}" text-anchor="end">보도가 많은 순 →</text>
      {% for p in gc.peaks %}
        <g class="pk" style="--delay:{{ p.delay }}s">
          <line x1="{{ '%.1f'|format(p.x) }}" x2="{{ '%.1f'|format(p.x) }}" y1="{{ '%.1f'|format(p.y - 6) }}" y2="{{ '%.1f'|format(p.y - 20) }}"/>
          <text x="{{ '%.1f'|format(p.x) }}" y="{{ '%.1f'|format(p.y - 38) }}" text-anchor="middle">{{ p.term }}</text>
          <text class="n" x="{{ '%.1f'|format(p.x) }}" y="{{ '%.1f'|format(p.y - 24) }}" text-anchor="middle">{{ p.n }}</text>
        </g>
      {% endfor %}
      <line class="cursor" x1="{{ gc.left }}" x2="{{ gc.left }}" y1="10" y2="{{ gc.base }}"/>
      {% else %}
      <text class="tick" x="{{ gc.width / 2 }}" y="{{ gc.height / 2 }}" text-anchor="middle">기준을 넘은 키워드가 없습니다</text>
      {% endif %}
    </svg>
    <figcaption>봉우리 위 숫자가 관련 보도 수입니다. 곡선 모양과 잔물결은 그림 효과일 뿐 자료가 아닙니다.</figcaption>
  </figure>
</header>

<main class="wrap">
<section class="frac">
  <div class="frac-id"><b>01</b></div>
  <div>
    <h2>요약</h2><p class="desc">키워드·시장·규제에서 한 줄씩 골랐습니다.</p>
    {{ b.summary_list() }}
  </div>
</section>

<section class="frac">
  <div class="frac-id"><b>02</b></div>
  <div>
    <h2>키워드별 내용</h2><p class="desc">각 키워드가 어떤 소식과 함께 나왔는지 정리했습니다.</p>
    {% if gate.sections.keywords.status == 'ok' %}
    <ul class="sents">{% for k in keywords %}<li class="rv"><b>{{ k.term }}</b> <span class="mono note">· 보도 {{ k.n_clusters }}건</span><br>{{ b.kw_explain(k) }}</li>{% endfor %}</ul>
    {% else %}{{ b.reduced('keywords') }}{% endif %}
    {% if viz.search %}
    <h3 class="rv">키워드별 네이버 검색량 추이('{{ viz.search.anchor }}' 대비)</h3>
    <div class="channels">
      {% for t, pts in viz.search.series.items() if t != viz.search.anchor %}
      {% set one = {t: pts} %}{% set g = line_paths(one, None, 400, 42, (4, 4, 4, 4)) %}
      {% set lastv = pts[-1][1] %}
      <div class="ch rv"><span class="nm">{{ t }}</span>
        <svg viewBox="0 0 400 42" preserveAspectRatio="none" aria-hidden="true">{% for l in g.lines %}<path class="draw" d="{{ l.d }}"/>{% endfor %}</svg>
        <span class="v">{{ '%.2f'|format(lastv) if lastv is not none else '—' }}<small>{{ pts[-1][0] }}</small></span></div>
      {% endfor %}
    </div>
    <p class="note">줄마다 키워드 하나의 월별 추이({{ viz.search.series[viz.search.anchor][0][0] }} ~ {{ month }})이고, 오른쪽 숫자는 {{ month }} 값입니다. 줄마다 세로 눈금이 달라 줄끼리 높이를 비교할 수는 없습니다. 실제 검색 횟수가 아니라 상대값입니다.</p>
    {% endif %}
  </div>
</section>

<section class="frac">
  <div class="frac-id"><b>03</b></div>
  <div>
    <h2>향 노트</h2><p class="desc">향 노트를 밝힌 제품 {{ agg.notes.n }}개 가운데 노트별로 몇 개 제품에 쓰였는지 셌습니다.</p>
    {% if viz.notes %}{% set nmax = viz.notes|map(attribute='count')|max %}
    <div class="ms rv"><ul>{% for n in viz.notes[:12] %}<li><span class="nm">{{ n.note }}</span><span class="stick" style="--w:{{ '%.3f'|format(n.count / nmax) }}"></span><span class="ct">{{ n.count }}</span></li>{% endfor %}</ul></div>
    <h3 class="rv">향 노트를 밝힌 제품</h3>
    <ul class="specimens">{% for x in agg.notes['items'] %}
      <li class="spec rv"><dl><dt>브랜드</dt><dd>{{ x.brand or '—' }}</dd><dt>제품</dt><dd>{{ x.name }}</dd><dt>향 노트</dt><dd>{{ x.notes|join(', ') }}</dd><dt>출처</dt><dd class="ref">{{ cite([x.doc_id]) }}</dd></dl></li>{% endfor %}
    </ul>
    {% else %}<p class="reduced">이번 달 기사에는 향 노트를 밝힌 제품이 없었습니다.</p>{% endif %}
    <h3 class="rv">신제품 출시</h3>
    {{ b.launches_table() }}
  </div>
</section>

<section class="frac">
  <div class="frac-id"><b>04</b></div>
  <div>
    <h2>시장 동향</h2><p class="desc">국내와 해외 소식입니다. 해외 소식 일부는 기사 제목·요약만 확인했습니다.</p>
    <h3 class="rv">국내</h3>{{ b.sents(market.kr, '이번 달에는 출처로 확인된 국내 시장 소식이 없습니다.') }}
    <h3 class="rv">해외</h3>{{ b.sents(market['global'], '이번 달에는 출처로 확인된 해외 시장 소식이 없습니다.') }}
  </div>
</section>

<section class="frac">
  <div class="frac-id"><b>05</b></div>
  <div>
    <h2>규제 · 원료 · 경쟁사</h2><p class="desc">규제기관 공지와 경쟁 향료사 발표입니다. 새로 나온 것이 없으면 "변경 없음"으로 적었습니다.</p>
    {{ b.reg_tables() }}
  </div>
</section>

<section class="frac">
  <div class="frac-id"><b>06</b></div>
  <div><h2>부록</h2>{{ b.appendix() }}</div>
</section>
</main>
<footer class="wrap note">{{ cfg.title }} · {{ month }} · AI가 자동으로 만든 리포트</footer>
<script>{% include "motion/_motion.js" %}</script>
</body>
</html>
