{% import "motion/_blocks.j2" as b with context %}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cfg.title }} {{ period.tag }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#FAFAF7; --ink:#0F1A16; --muted:#4F5B56; --grid:#E3E6E0; --grid-2:#EEF0EB;
  --trace:#0B6E4F; --hot:#B5532E; --panel:#FFFFFF;
  --stage:#DDE3DE; --ui-bg:#FAFAF7; --ui-line:#B8C2BC; --ui-ink:#0F1A16; --ui-muted:#4F5B56; --ui-hover:#EEF0EB;
  --sans:"Noto Sans KR","Apple SD Gothic Neo","Malgun Gothic","WenQuanYi Zen Hei",sans-serif;
  --mono:"JetBrains Mono",ui-monospace,monospace;
  --ease:cubic-bezier(.3,.7,0,1);
}
{% include "motion/_deck.css" %}
*{box-sizing:border-box}
body{word-break:keep-all;overflow-wrap:anywhere;color:var(--ink);font:16px/1.65 var(--sans);-webkit-font-smoothing:antialiased}
a{color:inherit}
a:focus-visible{outline:2px solid var(--hot);outline-offset:2px}
.mono{font-family:var(--mono)}

/* slide frame: graph paper */
.slide{padding:44px 72px 24px;box-shadow:0 14px 40px rgba(15,26,22,.14);
  background-color:var(--bg);
  background-image:linear-gradient(var(--grid-2) 1px,transparent 1px),linear-gradient(90deg,var(--grid-2) 1px,transparent 1px);
  background-size:24px 24px}
.s-head{display:grid;grid-template-columns:96px 1fr;column-gap:20px;margin-bottom:20px}
.s-kicker{grid-row:1/3;font:700 34px/1 var(--mono);color:var(--trace);letter-spacing:-.02em}
.s-head h2{font:700 32px/1.3 var(--sans);margin:0;letter-spacing:-.01em}
.s-page{font:500 16px var(--sans);color:var(--muted);margin-left:8px}
.s-desc{grid-column:2;margin:4px 0 0;color:var(--muted);font-size:15px}
.s-body{padding-left:116px}
.s-foot{display:flex;justify-content:space-between;font:12px var(--sans);color:var(--muted);border-top:1px solid var(--grid);padding-top:10px;margin-top:12px}
.s-num{font-family:var(--mono)}

/* reveal: slide in from the left like a trace */
.motion .rv{opacity:0;transform:translateX(-14px);transition:opacity .6s var(--ease),transform .8s var(--ease);transition-delay:calc(var(--i,0) * 80ms + 150ms)}
.motion .rv.in{opacity:1;transform:none}
.static .rv,.stacked .rv{opacity:1;transform:none}

/* cover */
.runlabel{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1.5px solid var(--ink);background:var(--panel)}
.runlabel div{padding:10px 14px;border-right:1px solid var(--grid)}
.runlabel div:last-child{border-right:0}
.runlabel span{display:block;font:500 12.5px/1.4 var(--sans);color:var(--muted)}
.runlabel b{font:600 17px/1.4 var(--mono)}
.sl-cover h1{font:700 40px/1.2 var(--sans);letter-spacing:-.02em;margin:22px 0 6px}
.sub{color:var(--muted);margin:0;font-size:15px;max-width:60em}
.banner{display:inline-block;margin:8px 8px 0 0;padding:2px 10px;font:12.5px var(--sans);background:var(--panel);border:1px solid var(--grid)}

/* chromatogram */
.gc{background:var(--panel);border:1.5px solid var(--ink);margin:14px 0 0;padding:8px 10px 0;flex:1;min-height:0;display:flex;flex-direction:column}
.gc svg{width:100%;flex:1;min-height:0;display:block}
.gc .axis{stroke:var(--ink);stroke-width:1.2}
.gc .tick{font:12px var(--sans);fill:var(--muted)}
.gc .trace{fill:none;stroke:var(--trace);stroke-width:2;stroke-linejoin:round}
.gc .fillarea{fill:color-mix(in srgb,var(--trace) 10%,transparent)}
.gc .cursor{stroke:var(--hot);stroke-width:1.2;stroke-dasharray:3 3}
.gc .pk text{font:600 15px var(--sans);fill:var(--ink)}
.gc .pk .n{font:500 13px var(--mono);fill:var(--hot)}
.gc .pk line{stroke:var(--ink);stroke-width:.8}
.motion .gc .trace{stroke-dasharray:var(--len);stroke-dashoffset:var(--len)}
.motion .in .gc .trace{animation:trace 2.4s linear .3s forwards}
@keyframes trace{to{stroke-dashoffset:0}}
.motion .gc .fillarea{opacity:0}
.motion .in .gc .fillarea{animation:fade .8s ease 2.7s forwards}
@keyframes fade{to{opacity:1}}
.motion .gc .cursor{opacity:0}
.motion .in .gc .cursor{animation:sweep 2.4s linear .3s forwards}
@keyframes sweep{0%{opacity:1;transform:translateX(0)}99%{opacity:1}100%{opacity:0;transform:translateX(var(--span))}}
.motion .gc .pk{opacity:0;transform:translateY(6px)}
.motion .in .gc .pk{animation:pk .5s var(--ease) forwards;animation-delay:calc(var(--delay) + .3s)}
@keyframes pk{to{opacity:1;transform:none}}
.gc figcaption{font-size:12.5px;color:var(--muted);padding:6px 4px 8px;border-top:1px solid var(--grid)}
.sl-cover{display:flex;flex-direction:column}

/* summary */
.summary{list-style:none;margin:0;padding:0;counter-reset:s}
.summary li{counter-increment:s;display:grid;grid-template-columns:70px 1fr;align-items:baseline;padding:18px 20px;background:var(--panel);border:1px solid var(--grid);margin-bottom:12px;font-size:21px;line-height:1.55}
.summary li::before{content:"RT " counter(s,decimal-leading-zero);font:600 13px var(--mono);color:var(--trace)}

/* keyword lines */
.kwl{list-style:none;margin:0;padding:0}
.kwl li{display:grid;grid-template-columns:190px 1fr;gap:18px;padding:12px 0;border-bottom:1px solid var(--grid)}
.kwl b{font:700 18px/1.4 var(--sans)}
.kwl small{display:block;font:500 13px var(--mono);color:var(--hot)}
.kwl p{margin:0;font-size:15.5px}
.reps{color:var(--muted)}

/* channels (search index per keyword) */
.channels{display:grid;gap:10px}
.ch{display:grid;grid-template-columns:170px 1fr 90px;gap:14px;align-items:center;background:var(--panel);border:1px solid var(--grid);padding:8px 14px}
.ch .nm{font:600 16px var(--sans)}
.ch svg{width:100%;height:52px;display:block}
.ch path.draw{fill:none;stroke:var(--trace);stroke-width:2}
.motion .ch path.draw{stroke-dasharray:var(--len);stroke-dashoffset:var(--len);transition:stroke-dashoffset 1.6s var(--ease);transition-delay:calc(var(--i) * 120ms + 300ms)}
.motion .ch.in path.draw{stroke-dashoffset:0}
.ch .v{font:600 16px var(--mono);text-align:right}
.ch .v small{display:block;font:12px var(--mono);color:var(--muted);font-weight:400}

/* notes spectrum */
.ms{background:var(--panel);border:1px solid var(--grid);padding:14px 18px 8px;columns:2;column-gap:40px}
.ms li{display:grid;grid-template-columns:120px 1fr 34px;gap:10px;align-items:center;height:36px;break-inside:avoid;list-style:none}
.ms ul{margin:0;padding:0}
.ms .nm{font-size:15px;text-align:right}
.ms .stick{position:relative;height:100%}
.ms .stick::before{content:"";position:absolute;left:0;top:50%;height:1.5px;width:calc(var(--w) * 100%);background:var(--ink);transform-origin:left;transition:transform 1.1s var(--ease);transition-delay:calc(var(--i) * 60ms + 300ms)}
.ms .stick::after{content:"";position:absolute;top:calc(50% - 5px);left:calc(var(--w) * 100% - 5px);width:10px;height:10px;border-radius:50%;background:var(--hot);transition:opacity .3s ease;transition-delay:calc(var(--i) * 60ms + 1.2s)}
.motion .ms .stick::before{transform:scaleX(0)}
.motion .ms .stick::after{opacity:0}
.motion .in .ms .stick::before{transform:scaleX(1)}
.motion .in .ms .stick::after{opacity:1}
.ms .ct{font:13px var(--mono);color:var(--muted)}

/* product labels */
.specimens{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;list-style:none;margin:0;padding:0}
.spec{background:var(--panel);border:1px solid var(--ink);padding:12px 14px;font-size:14.5px}
.spec dl{display:grid;grid-template-columns:62px 1fr;gap:3px 10px;margin:0}
.spec dt{font:500 12.5px/1.75 var(--sans);color:var(--muted)}
.spec dd{margin:0}

/* shared content */
h3{font:600 15px/1.4 var(--sans);color:var(--muted);margin:4px 0 8px}
ul.sents{margin:0 0 12px;padding:0;list-style:none}
ul.sents li{padding:11px 0 11px 24px;position:relative;border-bottom:1px solid var(--grid);font-size:17px}
ul.sents li::before{content:"▸";position:absolute;left:4px;top:11px;color:var(--trace);font-size:13px}
.cite{font:500 11px/1 var(--mono);margin-left:2px;vertical-align:super}.cite a{text-decoration:none;color:var(--hot)}
table{width:100%;border-collapse:collapse;font-size:15px;background:var(--panel)}
th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--grid);vertical-align:top}
th{font:600 13px var(--sans);color:var(--muted)}
th.c,td.c{text-align:center;width:70px}
td.mono{white-space:nowrap}
.tag{font:12px var(--sans);padding:0 6px;border:1px solid var(--grid);white-space:nowrap}
.reduced,.empty{font:15px/1.6 var(--sans);color:var(--muted);background:var(--panel);border:1px dashed var(--muted);padding:12px 14px;margin:12px 0 0}
.cal{list-style:none;padding:0;margin:0}.cal li{display:grid;grid-template-columns:150px 1fr;gap:16px;padding:14px 16px;background:var(--panel);border:1px solid var(--grid);margin-bottom:8px;font-size:17px}
.chart-wrap{margin:0;background:var(--panel);border:1px solid var(--grid);padding:10px}
.chart{width:100%;height:auto;display:block}
.chart .grid{stroke:var(--grid)}.chart .tick{font:13px var(--mono);fill:var(--muted)}
.chart .lbl{font:600 15px var(--sans)}
.chart path.draw{fill:none;stroke-width:2.2}
.motion .chart path.draw{stroke-dasharray:var(--len);stroke-dashoffset:var(--len);transition:stroke-dashoffset 1.8s var(--ease) .4s}
.motion .in .chart path.draw{stroke-dashoffset:0}
.note{font-size:13px;color:var(--muted)}
.sources{margin:0;padding:14px 14px 14px 42px;font-size:14.5px;line-height:1.5;background:var(--panel);border:1px solid var(--grid)}
.sources li{margin:0 0 8px;word-break:break-all}
.src-meta{color:var(--muted);font-size:13px}
.lk{color:var(--hot);font-size:12px}
.ai-note{margin-top:12px;font-size:13px;color:var(--muted)}

@media (max-width:760px){
  .slide{padding:24px 18px 18px;box-shadow:none}
  .runlabel{grid-template-columns:1fr 1fr}
  .runlabel div:nth-child(2){border-right:0}
  .runlabel div:nth-child(-n+2){border-bottom:1px solid var(--grid)}
  .sl-cover h1{font-size:26px}
  .gc svg{height:220px;flex:none}
  .s-head{grid-template-columns:1fr}.s-kicker{grid-row:auto;font-size:22px}.s-desc{grid-column:1}
  .s-head h2{font-size:23px}
  .s-body{padding-left:0;overflow-x:auto}
  .kwl li,.ch{grid-template-columns:1fr}
  .ms{columns:1}.ms li{grid-template-columns:84px 1fr 30px}
  .specimens{grid-template-columns:1fr}
  .summary li{grid-template-columns:1fr;font-size:17px}
  table{font-size:13px}th,td{padding:8px 5px}
}
@media print{
  .slide{box-shadow:none}
  .rv,.pk,.fillarea{opacity:1!important;transform:none!important;animation:none!important}
  .trace,path.draw{stroke-dashoffset:0!important;animation:none!important}
  .cursor{display:none}
  .ms .stick::before{transform:none!important}.ms .stick::after{opacity:1!important}
}
</style>
<script>if(!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches))document.documentElement.classList.add('motion')</script>
</head>
<body>
<main class="deck" aria-label="{{ cfg.title }} {{ month }}">

{% set gc = chromatogram(viz.keywords, 1110, 330) %}
<section class="slide sl-cover" data-title="표지">
  <div class="runlabel rv">
    <div><span>분석 월</span><b>{{ month }}</b></div>
    <div><span>분석 기사</span><b data-count="{{ agg.counts.docs }}">{{ agg.counts.docs }}</b></div>
    <div><span>같은 내용을 묶은 보도</span><b data-count="{{ agg.counts.clusters }}">{{ agg.counts.clusters }}</b></div>
    <div><span>작성</span><b>{{ generated[:16] }}</b></div>
  </div>
  <h1 class="rv" style="--i:1">{{ month[5:]|int }}월 업계 기사에서 두드러진 키워드</h1>
  <p class="sub rv" style="--i:2">향료 성분 분석에 쓰는 크로마토그램처럼 그렸습니다. 봉우리 하나가 키워드 하나이고, 높이는 그 키워드를 다룬 보도 수입니다. 네이버 데이터랩은 {{ month }}까지, 수출입 통계는 아직 싣지 않았습니다.</p>
  <div class="rv" style="--i:3">{{ b.banners() }}</div>
  <figure class="gc stage" style="--span:{{ gc.right - gc.left }}px">
    <svg viewBox="0 0 {{ gc.width }} {{ gc.height }}" preserveAspectRatio="xMidYMid meet" role="img"
         aria-label="키워드별 보도 수: {% for p in gc.peaks %}{{ p.term }} {{ p.n }}건{{ ', ' if not loop.last }}{% endfor %}">
      {% if gc.peaks %}
      <path class="fillarea" d="{{ gc.d }} L{{ gc.right }},{{ gc.base }} L{{ gc.left }},{{ gc.base }} Z"/>
      <path class="trace draw" d="{{ gc.d }}"/>
      <line class="axis" x1="{{ gc.left }}" x2="{{ gc.right }}" y1="{{ gc.base + 1 }}" y2="{{ gc.base + 1 }}"/>
      {% for i in range(0, 11) %}{% set x = gc.left + (gc.right - gc.left) * i / 10 %}<line class="axis" x1="{{ '%.1f'|format(x) }}" x2="{{ '%.1f'|format(x) }}" y1="{{ gc.base + 1 }}" y2="{{ gc.base + 6 }}"/>{% endfor %}
      <text class="tick" x="{{ gc.right }}" y="{{ gc.base + 24 }}" text-anchor="end">오른쪽으로 갈수록 보도가 많음</text>
      {% for p in gc.peaks %}
        <g class="pk" style="--delay:{{ p.delay }}s">
          <line x1="{{ '%.1f'|format(p.x) }}" x2="{{ '%.1f'|format(p.x) }}" y1="{{ '%.1f'|format(p.y - 6) }}" y2="{{ '%.1f'|format(p.y - 20) }}"/>
          <text x="{{ '%.1f'|format(p.x) }}" y="{{ '%.1f'|format(p.y - 40) }}" text-anchor="middle">{{ p.term }}</text>
          <text class="n" x="{{ '%.1f'|format(p.x) }}" y="{{ '%.1f'|format(p.y - 24) }}" text-anchor="middle">{{ p.n }}</text>
        </g>
      {% endfor %}
      <line class="cursor" x1="{{ gc.left }}" x2="{{ gc.left }}" y1="10" y2="{{ gc.base }}"/>
      {% else %}
      <text class="tick" x="{{ gc.width / 2 }}" y="{{ gc.height / 2 }}" text-anchor="middle">기준을 넘은 키워드가 없습니다</text>
      {% endif %}
    </svg>
    <figcaption>봉우리 위 숫자가 관련 보도 수입니다. 곡선 모양과 잔물결은 그림 효과일 뿐 자료가 아닙니다.</figcaption>
  </figure>
  <footer class="s-foot"><span>{{ cfg.title }} {{ period.tag }}</span><span class="s-num"></span></footer>
</section>

{{ b.summary_slide('01') }}

<section class="slide" data-title="키워드별 내용">
  <header class="s-head"><div class="s-kicker">02</div><h2 class="rv">키워드별 내용</h2>
    <p class="s-desc rv">각 키워드가 어떤 소식과 함께 나왔는지 정리했습니다.</p></header>
  <div class="s-body">
  {% if gate.sections.keywords.status == 'ok' %}
  <ul class="kwl">{% for k in keywords %}<li class="rv" style="--i:{{ loop.index0 }}"><div><b>{{ k.term }}</b><small>보도 {{ k.n_clusters }}건</small></div><p>{{ b.kw_explain(k) }}</p></li>{% endfor %}</ul>
  {% else %}{{ b.reduced('keywords') }}{% endif %}
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} {{ period.tag }}</span><span class="s-num"></span></footer>
</section>

{% if viz.search %}
<section class="slide" data-title="키워드별 네이버 검색량 추이">
  <header class="s-head"><div class="s-kicker">03</div><h2 class="rv">키워드별 네이버 검색량 추이</h2>
    <p class="s-desc rv">'{{ viz.search.anchor }}' 검색량을 1로 놓고 비교한 월별 값입니다. 줄마다 세로 눈금이 달라 줄끼리 높이를 비교할 수는 없습니다.</p></header>
  <div class="s-body">
    <div class="channels">
      {% for t, pts in viz.search.series.items() if t != viz.search.anchor %}
      {% set g = line_paths({t: pts}, None, 600, 52, (4, 4, 4, 4)) %}{% set lastv = pts[-1][1] %}
      <div class="ch rv" style="--i:{{ loop.index0 }}"><span class="nm">{{ t }}</span>
        <svg viewBox="0 0 600 52" preserveAspectRatio="none" aria-hidden="true">{% for l in g.lines %}<path class="draw" d="{{ l.d }}"/>{% endfor %}</svg>
        <span class="v">{{ '%.2f'|format(lastv) if lastv is not none else '-' }}<small>{{ pts[-1][0] }}</small></span></div>
      {% endfor %}
    </div>
    <p class="note rv">네이버 데이터랩, {{ viz.search.series[viz.search.anchor][0][0] }} ~ {{ month }}. 오른쪽 숫자는 {{ month }} 값이며 실제 검색 횟수가 아닙니다.</p>
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} {{ period.tag }}</span><span class="s-num"></span></footer>
</section>
{% endif %}

{% if viz.notes %}{% set nmax = viz.notes|map(attribute='count')|max %}
<section class="slide" data-title="향 노트">
  <header class="s-head"><div class="s-kicker">04</div><h2 class="rv">향 노트</h2>
    <p class="s-desc rv">향 노트를 밝힌 제품 {{ agg.notes.n }}개 가운데 노트별로 몇 개 제품에 쓰였는지 셌습니다.</p></header>
  <div class="s-body">
    <div class="ms stage"><ul>{% for n in viz.notes[:14] %}<li style="--i:{{ loop.index0 }}"><span class="nm">{{ n.note }}</span><span class="stick" style="--w:{{ '%.3f'|format(n.count / nmax) }}"></span><span class="ct">{{ n.count }}</span></li>{% endfor %}</ul></div>
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} {{ period.tag }}</span><span class="s-num"></span></footer>
</section>
{% for chunk in agg.notes['items']|batch(9) %}
<section class="slide" data-title="향 노트를 밝힌 제품{{ b.pg(loop) }}">
  <header class="s-head"><div class="s-kicker">04</div><h2 class="rv">향 노트를 밝힌 제품<span class="s-page">{{ b.pg(loop) }}</span></h2></header>
  <div class="s-body">
    <ul class="specimens">{% for x in chunk %}
      <li class="spec rv" style="--i:{{ loop.index0 }}"><dl><dt>브랜드</dt><dd>{{ x.brand or '-' }}</dd><dt>제품</dt><dd>{{ x.name }}</dd><dt>향 노트</dt><dd>{{ x.notes|join(', ') }}</dd><dt>출처</dt><dd>{{ cite([x.doc_id]) }}</dd></dl></li>{% endfor %}
    </ul>
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} {{ period.tag }}</span><span class="s-num"></span></footer>
</section>
{% endfor %}
{% endif %}

{{ b.launch_slides('05') }}
{{ b.market_slides('06') }}
{{ b.reg_slides('07') }}
{{ b.calendar_slide('09') }}

<!--SOURCE_SLIDES-->
</main>
{{ b.deck_ui() }}
<script>{% include "motion/_deck.js" %}</script>
</body>
</html>
