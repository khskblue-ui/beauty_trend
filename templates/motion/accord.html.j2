{% import "motion/_blocks.j2" as b with context %}
{%- set nkw = keywords|length -%}
{%- set nheart = agg.launches|length + agg.notes.n + market.kr|length + market['global']|length -%}
{%- set nbase = agg.regulation.regulation|length + agg.regulation.competitors|length + agg.calendar|length -%}
{%- macro pyramid(active='', size='') -%}
<svg class="pyr {{ size }} {{ 'act-' ~ active if active }}" viewBox="0 0 520 400" role="img" aria-label="이달 리포트 구성: 탑 키워드 {{ nkw }}개, 하트 제품, 시장 {{ nheart }}개, 베이스 규제, 경쟁사 {{ nbase }}개">
  <path class="wisp draw" d="M160 96 C 146 70, 178 54, 160 28 S 172 4, 164 -6"/>
  <path class="wisp draw" d="M138 100 C 120 76, 146 60, 130 36" style="stroke:var(--heart)"/>
  <path class="wisp draw" d="M182 100 C 202 80, 176 62, 194 40" style="stroke:var(--base)"/>
  <g class="band b-base"><path d="M10 392 L310 392 L254 270 L66 270 Z" fill="var(--base)"/><text class="cnt" x="160" y="342" text-anchor="middle">{{ nbase }}</text></g>
  <g class="band b-heart"><path d="M71 262 L249 262 L204 168 L116 168 Z" fill="var(--heart)"/><text class="cnt" x="160" y="224" text-anchor="middle">{{ nheart }}</text></g>
  <g class="band b-top"><path d="M120 160 L200 160 L160 100 Z" fill="var(--top)"/><text class="cnt" x="160" y="150" text-anchor="middle">{{ nkw }}</text></g>
  <g class="legend">
    <line x1="214" x2="330" y1="132" y2="132"/><text x="338" y="128">TOP</text><text class="sub" x="338" y="148">키워드</text>
    <line x1="232" x2="330" y1="215" y2="215"/><text x="338" y="211">HEART</text><text class="sub" x="338" y="231">제품, 노트, 시장</text>
    <line x1="285" x2="330" y1="331" y2="331"/><text x="338" y="327">BASE</text><text class="sub" x="338" y="347">규제, 경쟁사, 시행일</text>
  </g>
</svg>
{%- endmacro -%}
{%- macro divider(tier, no, title, desc) -%}
<section class="slide sl-divider ch-{{ tier }}" data-title="{{ title }}">
  <div class="dv">
    <div class="dv-text"><div class="dv-no rv">{{ no }}</div><h2 class="rv">{{ title }}</h2><p class="rv">{{ desc }}</p></div>
    <div class="stage dv-pyr">{{ pyramid(tier) }}</div>
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} {{ period.tag }}</span><span class="s-num"></span></footer>
</section>
{%- endmacro -%}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cfg.title }} {{ period.tag }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700&family=Noto+Sans+KR:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#F3EEE7; --paper-2:#EAE3D9; --ink:#26201C; --muted:#5F564E; --line:#D6CCBF;
  --top:#8E3B4A; --heart:#9A5B1E; --base:#3F5A4A;
  --stage:#E4DBCF; --ui-bg:#F3EEE7; --ui-line:#CFC4B6; --ui-ink:#26201C; --ui-muted:#6F655C; --ui-hover:#EAE3D9;
  --serif:"Noto Serif KR","Nanum Myeongjo",serif;
  --sans:"Noto Sans KR","Apple SD Gothic Neo","Malgun Gothic","WenQuanYi Zen Hei",sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,monospace;
  --ease:cubic-bezier(.2,.7,.1,1);
}
{% include "motion/_deck.css" %}
*{box-sizing:border-box}
body{word-break:keep-all;overflow-wrap:anywhere;color:var(--ink);font:16px/1.65 var(--sans);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration-color:var(--line);text-underline-offset:3px}
a:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.mono{font-family:var(--mono);font-size:.92em}

/* slide frame */
.slide{background:var(--paper);padding:52px 84px 26px;--c:var(--muted);box-shadow:0 18px 50px rgba(60,40,20,.12)}
.ch-top{--c:var(--top)}.ch-heart{--c:var(--heart)}.ch-base{--c:var(--base)}
.s-head{margin-bottom:22px}
.s-kicker{font:500 13px/1 var(--sans);color:var(--c);margin-bottom:12px;display:flex;align-items:center;gap:8px}
.s-kicker::before{content:"";width:9px;height:9px;border-radius:50%;background:var(--c)}
.s-head h2{font:700 38px/1.25 var(--serif);margin:0;letter-spacing:-.01em}
.s-page{font:500 18px var(--sans);color:var(--muted);margin-left:10px}
.s-desc{margin:8px 0 0;color:var(--muted);font-size:15.5px}
.s-foot{display:flex;justify-content:space-between;font:12px var(--sans);color:var(--muted);border-top:1px solid var(--line);padding-top:10px;margin-top:14px}
.s-num{font-family:var(--mono)}

/* diffusion reveal: blur + tracking settle, like scent opening up */
.motion .rv{opacity:0;filter:blur(7px);letter-spacing:.03em;transform:translateY(10px);
  transition:opacity .8s var(--ease),filter 1s var(--ease),letter-spacing 1.1s var(--ease),transform .8s var(--ease);
  transition-delay:calc(var(--i,0) * 110ms + 120ms)}
.motion .rv.in{opacity:1;filter:none;letter-spacing:normal;transform:none}
.static .rv,.stacked .rv{opacity:1;filter:none;transform:none}

/* cover */
.sl-cover{display:grid;grid-template-columns:1.15fr .85fr;gap:36px;align-items:center;padding-top:60px}
.sl-cover .s-foot{grid-column:1/-1;align-self:end}
.kicker{font:500 14px/1 var(--sans);color:var(--muted)}
.sl-cover h1{font:700 62px/1.1 var(--serif);margin:16px 0 18px;letter-spacing:-.01em}
.sl-cover h1 em{font-style:normal;color:var(--heart)}
.lede{font:400 18px/1.7 var(--serif);color:var(--muted);margin:0}
.meta{margin-top:22px;display:grid;grid-template-columns:max-content 1fr;gap:5px 18px;font-size:13.5px;color:var(--muted)}
.banner{display:inline-block;margin:14px 8px 0 0;padding:4px 12px;border:1px solid var(--line);border-radius:999px;font-size:12.5px;color:var(--muted);background:var(--paper-2)}

/* pyramid */
.pyr{width:100%;max-width:470px;overflow:visible;display:block;margin:0 auto}
.pyr.small{max-width:380px}
.pyr .legend line{stroke:var(--line)}
.pyr text{font-family:var(--mono);font-size:13px;letter-spacing:.12em}
.pyr .legend text{fill:var(--ink)}
.pyr .legend .sub{fill:var(--muted);font-family:var(--sans);letter-spacing:0;font-size:13.5px}
.pyr .band text{fill:var(--paper)}
.pyr .cnt{font-family:var(--serif);font-size:28px;letter-spacing:0;font-weight:700}
.pyr .band{transform-origin:50% 100%;transform-box:fill-box;transition:opacity .9s var(--ease),transform 1.1s var(--ease),filter .6s ease}
.pyr .wisp{fill:none;stroke:var(--top);stroke-width:1.3;opacity:.55}
.motion .pyr .band{opacity:0;transform:translateY(18px) scaleY(.85)}
.motion .in .pyr .band,.motion .pyr.in .band{opacity:1;transform:none}
.motion .in .pyr .b-base{transition-delay:.05s}.motion .in .pyr .b-heart{transition-delay:.3s}.motion .in .pyr .b-top{transition-delay:.55s}
.motion .pyr .legend{opacity:0;transition:opacity .8s ease 1.1s}
.motion .in .pyr .legend{opacity:1}
.motion .pyr .wisp{stroke-dasharray:var(--len);stroke-dashoffset:var(--len)}
.motion .in .pyr .wisp{animation:rise 3s var(--ease) 1s forwards}
@keyframes rise{to{stroke-dashoffset:0}}
/* chapter divider: the active layer stays, the others fade back */
.act-top .band:not(.b-top),.act-heart .band:not(.b-heart),.act-base .band:not(.b-base){filter:saturate(.15) opacity(.28)}
.sl-divider{padding:0}
.dv{flex:1;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:30px;padding:60px 84px 0}
.dv-no{font:700 120px/1 var(--serif);color:var(--c);opacity:.9}
.dv h2{font:700 46px/1.2 var(--serif);margin:10px 0 12px}
.dv p{font:400 18px/1.7 var(--serif);color:var(--muted);margin:0;max-width:24em}
.sl-divider .s-foot{margin:0 84px 26px}

/* summary */
.summary{list-style:none;counter-reset:s;margin:6px 0 0;padding:0}
.summary li{counter-increment:s;display:grid;grid-template-columns:62px 1fr;gap:14px;padding:22px 0;border-top:1px solid var(--line);font:400 24px/1.55 var(--serif)}
.summary li::before{content:counter(s,decimal-leading-zero);font:500 15px/2.4 var(--mono);color:var(--top)}

/* keyword vials */
.kws{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.kw{position:relative;background:var(--paper-2);border-radius:16px 16px 4px 4px;padding:20px 20px 18px;overflow:hidden;min-height:196px}
.kw::after{content:"";position:absolute;left:0;right:0;bottom:0;height:calc(var(--fill,0) * 100%);background:linear-gradient(to top,color-mix(in srgb,var(--top) 16%,transparent),transparent);transform:scaleY(0);transform-origin:bottom;transition:transform 1.5s var(--ease) .4s;pointer-events:none}
.static .kw::after,.stacked .kw::after,.kw.in::after{transform:scaleY(1)}
.kw strong{display:block;font:700 24px/1.3 var(--serif);color:var(--top)}
.kwn{display:block;font:13px/1.6 var(--sans);color:var(--muted);margin:4px 0 10px}
.kwn b{font-family:var(--mono);font-weight:500;color:var(--ink)}
.kw p{margin:0;font-size:14.5px;line-height:1.6;position:relative;z-index:1}
.reps{color:var(--muted)}

/* notes: blotter strips */
.strips{list-style:none;margin:0;padding:0;columns:2;column-gap:56px}
.strip{display:grid;grid-template-columns:130px 1fr 50px;align-items:center;gap:12px;padding:6px 0;break-inside:avoid}
.strip .nm{font:500 16px/1.3 var(--serif);text-align:right}
.strip .bar{height:16px;border-radius:0 8px 8px 0;background:linear-gradient(90deg,var(--heart),color-mix(in srgb,var(--heart) 45%,var(--paper)));transform-origin:left;transform:scaleX(var(--w))}
.motion .strip .bar{transform:scaleX(0);transition:transform 1.3s var(--ease);transition-delay:calc(var(--i) * 70ms + 300ms)}
.motion .in .strip .bar{transform:scaleX(var(--w))}
.strip .ct{font:13px var(--mono);color:var(--muted)}

/* base: horizon to the effective date */
.horizon{position:relative;height:120px;margin:40px 0 10px}
.horizon .ln{position:absolute;left:0;right:0;top:58px;height:2px;background:var(--line)}
.horizon .fill{position:absolute;left:0;top:56px;height:6px;width:var(--p);background:var(--base);transform-origin:left;transition:transform 2.4s var(--ease) .3s}
.motion .horizon .fill{transform:scaleX(0)}
.motion .in .horizon .fill{transform:scaleX(1)}
.horizon .pt{position:absolute;top:22px;font:14px/1.4 var(--mono);color:var(--muted)}
.horizon .pt.now{left:0}.horizon .pt.end{right:0;text-align:right;color:var(--base)}
.horizon .pt::after{content:"";position:absolute;top:30px;width:14px;height:14px;border-radius:50%;background:currentColor}
.horizon .pt.now::after{left:0}.horizon .pt.end::after{right:0}
.horizon .pt span{display:block;margin-top:34px;font-family:var(--sans)}
.horizon .big{font:700 64px/1 var(--serif);color:var(--base)}
.hz-note{font:400 18px/1.7 var(--serif);color:var(--muted);max-width:44em}

/* shared content */
h3{font:600 20px/1.4 var(--serif);margin:6px 0 10px}
ul.sents{margin:0;padding:0 0 0 22px}
ul.sents li{margin:0 0 14px;font-size:18px;line-height:1.6}
.sl-market ul.sents li{font-size:17px;margin-bottom:10px}
.cite{font:500 11px/1 var(--mono);margin-left:2px;vertical-align:super}.cite a{text-decoration:none;color:var(--heart)}
table{width:100%;border-collapse:collapse;font-size:15px}
th,td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line);vertical-align:top}
th{font:500 13px/1.4 var(--sans);color:var(--muted)}
th.c,td.c{text-align:center;width:70px}
td.mono{white-space:nowrap}
.tag{font:12px var(--sans);padding:1px 7px;border:1px solid var(--line);border-radius:999px;color:var(--muted);white-space:nowrap}
.reduced,.empty{border-left:3px solid var(--line);padding:12px 16px;color:var(--muted);background:var(--paper-2);font-size:16px;margin:14px 0 0}
.cal{list-style:none;padding:0;margin:0}.cal li{display:grid;grid-template-columns:150px 1fr;gap:16px;padding:14px 0;border-bottom:1px solid var(--line);font-size:17px}
.chart-wrap{margin:0}
.chart{width:100%;height:auto;display:block}
.chart .grid{stroke:var(--line)}.chart .tick{font:13px var(--mono);fill:var(--muted)}
.chart .lbl{font:600 16px var(--serif)}
.chart path.draw{fill:none;stroke-width:2.6;stroke-linecap:round}
.motion .chart path.draw{stroke-dasharray:var(--len);stroke-dashoffset:var(--len);transition:stroke-dashoffset 1.8s var(--ease) .4s}
.motion .in .chart path.draw{stroke-dashoffset:0}
.note{font-size:13px;color:var(--muted)}
.sources{margin:0;padding-left:30px;font-size:14.5px;line-height:1.5}
.sources li{margin:0 0 9px;word-break:break-all}
.src-meta{color:var(--muted);font-size:13px}
.lk{color:var(--heart);font-size:12px}
.ai-note{margin-top:14px;font-size:13px;color:var(--muted)}

@media (max-width:760px){
  .slide{padding:28px 20px 18px;box-shadow:none}
  .sl-cover,.dv{grid-template-columns:1fr;padding:28px 0 0}
  .sl-cover h1{font-size:34px}
  .dv-no{font-size:64px}.dv h2{font-size:30px}
  .sl-divider .s-foot{margin:0}
  .s-head h2{font-size:26px}
  .summary li{grid-template-columns:36px 1fr;font-size:18px}
  .kws{grid-template-columns:1fr}
  .strips{columns:1}
  .strip{grid-template-columns:88px 1fr 40px}
  table{font-size:13px}th,td{padding:8px 5px}
  .tw,.s-body{overflow-x:auto}
}
@media print{
  .rv,.band,.bar,.fill,.legend{opacity:1!important;filter:none!important;transform:none!important}
  .strip .bar{transform:scaleX(var(--w))!important}
  path.draw,.wisp{stroke-dashoffset:0!important;animation:none!important}
  .slide{box-shadow:none}
}
</style>
<script>if(!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches))document.documentElement.classList.add('motion')</script>
</head>
<body>
<main class="deck" aria-label="{{ cfg.title }} {{ month }}">

<section class="slide sl-cover" data-title="표지">
  <div>
    <div class="kicker rv">월간 뷰티, 향료 리포트, {{ month }}</div>
    <h1 class="rv" style="--i:1">{{ month[5:]|int }}월 업계, <em>먼저 뜬 것</em>과 오래 남을 것</h1>
    <p class="lede rv" style="--i:2">향수의 탑, 하트, 베이스 노트 순서로 정리했습니다. 탑에는 이달 많이 다뤄진 키워드, 하트에는 신제품, 향 노트, 시장 소식, 베이스에는 오래 영향을 주는 규제와 시행일을 담았습니다.</p>
    <div class="meta rv" style="--i:3">
      <span>분석 기간</span><span class="mono">{{ month }}-01 ~ {{ month }} 말일</span>
      <span>분석 기사</span><span><b class="mono" data-count="{{ agg.counts.docs }}">{{ agg.counts.docs }}</b>건(같은 내용을 하나로 묶으면 <b class="mono" data-count="{{ agg.counts.clusters }}">{{ agg.counts.clusters }}</b>건)</span>
      <span>자료 기준</span><span>기사, 규제 {{ month }}, 네이버 데이터랩 {{ month }}까지, 수출입 통계는 아직 싣지 않음</span>
      <span>작성</span><span class="mono">{{ generated }}</span>
    </div>
    <div class="rv" style="--i:4">{{ b.banners() }}</div>
  </div>
  <div class="stage">{{ pyramid() }}</div>
  <footer class="s-foot"><span>{{ cfg.title }} {{ period.tag }}</span><span class="s-num"></span></footer>
</section>

{{ b.summary_slide('요약') }}

{{ divider('top', '01', '탑 노트: 먼저 뜬 키워드', '서로 다른 보도에서 두 번 이상 다뤄진 말만 골랐습니다. 가장 먼저 눈에 띄는 이달의 변화입니다.') }}

<section class="slide ch-top" data-title="이달의 키워드">
  <header class="s-head"><div class="s-kicker">탑 노트</div><h2 class="rv">이달의 키워드</h2>
    <p class="s-desc rv">카드 아래 색이 찬 높이는 보도가 가장 많은 키워드를 기준으로 한 상대 크기입니다.</p></header>
  <div class="s-body">
  {% if gate.sections.keywords.status == 'ok' %}
  {% set kmax = (keywords|map(attribute='n_clusters')|max) if keywords else 1 %}
  <ul class="kws">{% for k in keywords %}<li class="kw rv" style="--i:{{ loop.index0 }};--fill:{{ '%.2f'|format(k.n_clusters / kmax) }}"><strong>{{ k.term }}</strong><span class="kwn">관련 보도 <b data-count="{{ k.n_clusters }}">{{ k.n_clusters }}</b>건{% if agg.keywords.has_prev %}, 전월 {{ k.n_prev }}건{% endif %}</span><p>{{ b.kw_explain(k) }}</p></li>{% endfor %}</ul>
  {% else %}{{ b.reduced('keywords') }}{% endif %}
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} {{ period.tag }}</span><span class="s-num"></span></footer>
</section>

{{ b.search_slide('탑 노트', ['var(--top)','var(--heart)','var(--base)','#6B5B8C']) }}

{{ divider('heart', '02', '하트 노트: 한 달을 채운 제품과 시장', '출시일이 기사로 확인된 신제품, 향 노트를 밝힌 제품, 국내외 시장 소식입니다.') }}

{% if viz.notes %}{% set nmax = viz.notes|map(attribute='count')|max %}
<section class="slide ch-heart" data-title="향 노트별 제품 수">
  <header class="s-head"><div class="s-kicker">하트 노트</div><h2 class="rv">향 노트별 제품 수</h2>
    <p class="s-desc rv">향 노트를 밝힌 제품 {{ agg.notes.n }}개 기준입니다. 같은 제품을 다룬 기사가 여럿이어도 한 번만 셌습니다.</p></header>
  <div class="s-body">
    <ul class="strips stage" aria-label="향 노트별 제품 수">{% for n in viz.notes[:12] %}
      <li class="strip" style="--i:{{ loop.index0 }};--w:{{ '%.3f'|format(n.count / nmax) }}"><span class="nm">{{ n.note }}</span><span class="bar"></span><span class="ct">{{ n.count }}개</span></li>{% endfor %}
    </ul>
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} {{ period.tag }}</span><span class="s-num"></span></footer>
</section>
{% endif %}
{{ b.notes_table_slides('하트 노트') }}
{{ b.launch_slides('하트 노트') }}
{{ b.market_slides('하트 노트') }}

{{ divider('base', '03', '베이스 노트: 오래 영향을 주는 규제', '규제기관 공지와 경쟁 향료사 발표입니다. 새로 나온 것이 없으면 "변경 없음"으로 적었습니다.') }}

{{ b.reg_slides('베이스 노트') }}

{% for c0 in viz.calendar if c0.elapsed is defined %}
<section class="slide ch-base" data-title="시행일 일정">
  <header class="s-head"><div class="s-kicker">베이스 노트</div><h2 class="rv">시행일 일정</h2>
    <p class="s-desc rv">{{ c0.item }}</p></header>
  <div class="s-body">
    <div class="horizon stage" style="--p:{{ '%.1f'|format(c0.elapsed * 100) }}%" aria-label="{{ c0.start }} 채택, {{ c0.date }} 기한, {{ c0.days_left }}일 남음">
      <div class="ln"></div><div class="fill"></div>
      <div class="pt now">{{ c0.start }}<span>규정 채택</span></div>
      <div class="pt end">{{ c0.date }}<span>기존 유통품 판매 기한</span></div>
    </div>
    <p class="rv" style="--i:1"><span class="big" data-count="{{ c0.days_left }}">{{ c0.days_left }}</span> <span class="hz-note">일 남았습니다.</span></p>
    <p class="hz-note rv" style="--i:2">채택일부터 기한까지 전체 기간의 {{ '%.0f'|format(c0.elapsed * 100) }}%가 지났습니다. <a href="{{ c0.source }}">원문</a></p>
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} {{ period.tag }}</span><span class="s-num"></span></footer>
</section>
{% endfor %}

<!--SOURCE_SLIDES-->
</main>
{{ b.deck_ui() }}
<script>{% include "motion/_deck.js" %}</script>
</body>
</html>
