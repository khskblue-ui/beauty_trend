{% import "motion/_blocks.j2" as b with context %}
{%- set colors = {'market':'var(--k-market)','launch':'var(--k-launch)','regulation':'var(--k-reg)','competitor':'var(--k-comp)'} -%}
{%- set kname = {'market':'시장','launch':'신제품','regulation':'규제','competitor':'경쟁사'} -%}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ period.tag }} Signal Desk — {{ cfg.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F6F6F3; --ink:#111418; --muted:#545B63; --grid:#E1E1DA; --rule:#111418;
  --k-market:#111418; --k-launch:#C2410C; --k-reg:#0B7285; --k-comp:#6741D9;
  --stage:#DCDCD5; --ui-bg:#F6F6F3; --ui-line:#B9B9B1; --ui-ink:#111418; --ui-muted:#545B63; --ui-hover:#ECECE6;
  --sans:"IBM Plex Sans KR","Noto Sans KR","Apple SD Gothic Neo","Malgun Gothic","WenQuanYi Zen Hei",sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,monospace;
  --snap:cubic-bezier(.16,1,.3,1);
}
{% include "motion/_deck.css" %}
*{box-sizing:border-box}
body{word-break:keep-all;overflow-wrap:anywhere;color:var(--ink);font:16px/1.6 var(--sans);-webkit-font-smoothing:antialiased}
a{color:inherit}
a:focus-visible{outline:2px solid var(--k-launch);outline-offset:2px}
.mono{font-family:var(--mono)}

/* slide frame: a wire page */
.slide{background:var(--bg);padding:0 72px 24px;box-shadow:0 14px 40px rgba(0,0,0,.14)}
.motion .slide{clip-path:inset(0 0 0 100%);transition:clip-path .55s var(--snap),visibility 0s linear .55s}
.motion .slide.active{clip-path:inset(0);transition:clip-path .55s var(--snap)}
.static .slide,.stacked .slide{clip-path:none}
.slide::before{content:"뷰티·향료 업계 소식 · {{ period.tag }}";display:block;margin:0 -72px 34px;padding:14px 72px;border-bottom:2px solid var(--rule);font:500 13px/1 var(--sans)}
.s-head{display:grid;grid-template-columns:120px 1fr;column-gap:24px;margin-bottom:22px}
.s-kicker{grid-row:1/3;font:600 15px/1.2 var(--mono);color:var(--k-launch);padding-top:6px}
.s-head h2{font:700 34px/1.25 var(--sans);margin:0;letter-spacing:-.01em}
.s-page{font:500 17px var(--sans);color:var(--muted);margin-left:8px}
.s-desc{grid-column:2;margin:6px 0 0;color:var(--muted);font-size:15px}
.s-body{padding-left:144px}
.s-foot{display:flex;justify-content:space-between;font:12px var(--sans);color:var(--muted);border-top:1px solid var(--grid);padding-top:10px;margin-top:14px}
.s-num{font-family:var(--mono)}

/* reveal: wipe down + snap */
.motion .rv{opacity:0;clip-path:inset(0 0 100% 0);transform:translateY(6px);
  transition:opacity .4s ease,clip-path .6s var(--snap),transform .6s var(--snap);transition-delay:calc(var(--i,0) * 90ms + 200ms)}
.motion .rv.in{opacity:1;clip-path:inset(0 0 0 0);transform:none}
.static .rv,.stacked .rv{opacity:1;clip-path:none;transform:none}

/* cover */
.sl-cover{padding-bottom:24px}
.sl-cover::before{content:"뷰티·향료 업계 소식";}
.mast{flex:1;display:grid;grid-template-columns:auto 1fr;gap:44px;align-items:center}
.bignum{font:600 260px/.8 var(--mono);letter-spacing:-.06em}
.bignum small{display:block;font-size:.17em;letter-spacing:0;color:var(--muted);margin-bottom:14px}
.mast h1{font:700 46px/1.2 var(--sans);margin:0 0 20px;letter-spacing:-.01em}
.stats{display:flex;border-top:1px solid var(--grid)}
.stat{padding:14px 26px 4px 0;margin-right:26px;border-right:1px solid var(--grid)}
.stat:last-child{border-right:0}
.stat b{display:block;font:600 34px/1.1 var(--mono)}
.stat span{font:13px var(--sans);color:var(--muted)}
.mast .note{margin-top:14px}
.banner{display:inline-block;margin:12px 8px 0 0;padding:4px 10px;font:12.5px var(--sans);border:1px solid var(--ink)}

/* month strip slide */
.legend{display:flex;gap:18px;flex-wrap:wrap;list-style:none;margin:0 0 6px;padding:0;font:14px var(--sans)}
.legend li{display:flex;align-items:center;gap:7px}
.legend i{width:12px;height:12px;display:inline-block;background:var(--c)}
.month-strip{width:100%;height:auto;display:block}
.month-strip .day{font:12px var(--mono);fill:var(--muted)}
.month-strip .axis{stroke:var(--ink);stroke-width:1.5}
.month-strip .tickl{stroke:var(--grid)}
.month-strip .ev{transform-box:fill-box;transform-origin:50% 100%}
.motion .stage .ev{opacity:0;transform:translateY(-34px)}
.motion .in .stage .ev,.motion .stage.in .ev{animation:drop .55s var(--snap) forwards;animation-delay:calc(var(--d) * 45ms + var(--s) * 60ms + 300ms)}
@keyframes drop{to{opacity:1;transform:none}}
.month-strip .scan{stroke:var(--k-launch);stroke-width:1.5}
.motion .in .stage .scan{animation:scan calc(var(--n) * 45ms + 900ms) linear forwards}
@keyframes scan{to{transform:translateX(var(--w))}}
.static .scan,.stacked .scan{display:none}
.sl-strip .s-body{padding-left:0}

/* summary */
.summary{list-style:none;margin:0;padding:0;counter-reset:s}
.summary li{display:grid;grid-template-columns:52px 1fr;padding:20px 0;border-bottom:1px solid var(--grid);font:500 22px/1.55 var(--sans);counter-increment:s}
.summary li::before{content:counter(s,decimal-leading-zero);font:600 15px/2.2 var(--mono);color:var(--k-launch)}

/* keyword bars */
.kbars{list-style:none;margin:0;padding:0}
.kbar{display:grid;grid-template-columns:200px 1fr;gap:20px;padding:12px 0;border-bottom:1px solid var(--grid)}
.kbar .t{font:700 19px/1.35 var(--sans)}
.kbar .t small{display:block;font:13px var(--sans);color:var(--muted);font-weight:400;margin-top:2px}
.kbar .track{position:relative;height:10px;background:var(--grid);margin:6px 0 8px}
.kbar .val{position:absolute;inset:0 auto 0 0;width:calc(var(--w) * 100%);background:var(--ink);transform-origin:left;transition:transform 1s var(--snap);transition-delay:calc(var(--i) * 90ms + 350ms)}
.motion .kbar .val{transform:scaleX(0)}
.motion .kbar.in .val{transform:scaleX(1)}
.kbar p{margin:0;font-size:14.5px}
.reps{color:var(--muted)}

/* notes ranking */
.rank{list-style:none;margin:0;padding:0;columns:2;column-gap:48px}
.rank li{display:grid;grid-template-columns:34px 120px 1fr 44px;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--grid);break-inside:avoid;font-size:16px}
.rank .no{font:600 14px var(--mono);color:var(--k-launch)}
.rank .tr{height:8px;background:var(--grid);position:relative}
.rank .tr i{position:absolute;inset:0 auto 0 0;width:calc(var(--w) * 100%);background:var(--ink);transform-origin:left;transition:transform .9s var(--snap);transition-delay:calc(var(--i) * 60ms + 300ms)}
.motion .rank .tr i{transform:scaleX(0)}
.motion .in .rank .tr i{transform:scaleX(1)}
.rank .ct{font:13px var(--mono);color:var(--muted);text-align:right}

/* shared content */
h3{font:600 15px/1.4 var(--sans);color:var(--muted);margin:4px 0 8px}
ul.sents{list-style:none;margin:0 0 14px;padding:0}
ul.sents li{padding:11px 0 11px 20px;border-bottom:1px solid var(--grid);position:relative;font-size:17px}
ul.sents li::before{content:"";position:absolute;left:0;top:23px;width:9px;height:2px;background:var(--ink)}
.cite{font:500 11px/1 var(--mono);margin-left:2px;vertical-align:super}.cite a{text-decoration:none;color:var(--k-launch)}
table{width:100%;border-collapse:collapse;font-size:15px}
th,td{text-align:left;padding:10px 10px;border-bottom:1px solid var(--grid);vertical-align:top}
th{font:500 13px var(--sans);color:var(--muted);border-bottom:1.5px solid var(--ink)}
th.c,td.c{text-align:center;width:70px}
td.mono{white-space:nowrap}
.tag{font:12px var(--sans);padding:0 6px;border:1px solid var(--ink);white-space:nowrap}
.reduced,.empty{font:15px/1.6 var(--sans);color:var(--muted);border:1px dashed var(--muted);padding:12px 14px;margin:12px 0 0}
.cal{list-style:none;padding:0;margin:0}.cal li{display:grid;grid-template-columns:150px 1fr;gap:16px;padding:14px 0;border-bottom:1px solid var(--grid);font-size:17px}
.chart-wrap{margin:0}
.chart{width:100%;height:auto;display:block}
.chart .grid{stroke:var(--grid)}.chart .tick{font:13px var(--mono);fill:var(--muted)}
.chart .lbl{font:600 15px var(--sans)}
.chart path.draw{fill:none;stroke-width:2.4;stroke-linejoin:round}
.motion .chart path.draw{stroke-dasharray:var(--len);stroke-dashoffset:var(--len);transition:stroke-dashoffset 1.8s var(--snap) .4s}
.motion .in .chart path.draw{stroke-dashoffset:0}
.sl-search .s-body{padding-left:0}
.note{font-size:13px;color:var(--muted)}
.sources{margin:0;padding-left:30px;font-size:14.5px;line-height:1.5}
.sources li{margin:0 0 9px;word-break:break-all}
.src-meta{color:var(--muted);font-size:13px}
.lk{color:var(--k-launch);font-size:12px}
.ai-note{margin-top:14px;font-size:13px;color:var(--muted)}

@media (max-width:760px){
  .slide{padding:0 18px 18px;box-shadow:none}
  .slide::before{margin:0 -18px 20px;padding:12px 18px}
  .mast{grid-template-columns:1fr;gap:12px}
  .bignum{font-size:110px}
  .mast h1{font-size:28px}
  .s-head{grid-template-columns:1fr}
  .s-kicker{grid-row:auto}
  .s-desc{grid-column:1}
  .s-head h2{font-size:24px}
  .s-body{padding-left:0;overflow-x:auto}
  .kbar{grid-template-columns:1fr;gap:4px}
  .rank{columns:1}
  .stat{padding-right:14px;margin-right:14px}
  .stat b{font-size:24px}
  table{font-size:13px}th,td{padding:8px 5px}
}
@media print{
  .slide{clip-path:none!important;box-shadow:none}
  .rv,.ev,.val,.tr i{opacity:1!important;clip-path:none!important;transform:none!important;animation:none!important}
  .scan{display:none}
  path.draw{stroke-dashoffset:0!important}
}
</style>
<script>if(!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches))document.documentElement.classList.add('motion')</script>
</head>
<body>
<main class="deck" aria-label="{{ cfg.title }} {{ month }}">

<section class="slide sl-cover" data-title="표지">
  <div class="mast">
    <div class="bignum rv"><small>{{ month[:4] }}</small>{{ month[5:] }}</div>
    <div>
      <h1 class="rv" style="--i:1">{{ period.span }} 업계 소식을 날짜순으로 모았습니다</h1>
      <div class="stats rv" style="--i:2">
        <div class="stat"><b data-count="{{ agg.counts.docs }}">{{ agg.counts.docs }}</b><span>분석 기사</span></div>
        <div class="stat"><b data-count="{{ agg.counts.clusters }}">{{ agg.counts.clusters }}</b><span>같은 내용을 묶은 보도</span></div>
        <div class="stat"><b data-count="{{ viz.events|length }}">{{ viz.events|length }}</b><span>날짜별로 정리한 주요 소식</span></div>
      </div>
      <p class="note rv" style="--i:3">분석 기간 {{ period.start }} ~ {{ period.end }}(한국 시간){% if period.interim %} · 월중 중간 보고라 전월 비교는 넣지 않음{% endif %} · 수출입 통계는 아직 싣지 않음 · 작성 {{ generated }}</p>
      <div class="rv" style="--i:4">{{ b.banners() }}</div>
    </div>
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} · {{ period.tag }}</span><span class="s-num"></span></footer>
</section>

{% set W = 1136 %}{% set H = 330 %}{% set L = 10 %}{% set R = 10 %}{% set step = (W - L - R) / viz.days %}{% set base = H - 30 %}
<section class="slide sl-strip" data-title="날짜별 주요 소식">
  <header class="s-head"><div class="s-kicker">01</div><h2 class="rv">날짜별 주요 소식</h2>
    <p class="s-desc rv">칸 하나가 하루, 막대 하나가 소식 하나입니다. 소식의 내용은 뒤쪽 슬라이드에 있습니다.</p></header>
  <div class="s-body">
    <ul class="legend rv">{% for k, n in viz.kinds.items() %}<li style="--c:{{ colors[k] }}"><i></i>{{ kname[k] }} {{ n }}건</li>{% endfor %}</ul>
    <svg class="month-strip stage" viewBox="0 0 {{ W }} {{ H }}" role="img" style="--n:{{ viz.days }};--w:{{ W - L - R }}px"
         aria-label="{{ period.span }} 날짜별 주요 소식 수: {% for k, n in viz.kinds.items() %}{{ kname[k] }} {{ n }}건{{ ', ' if not loop.last }}{% endfor %}">
      {% for d in range(1, viz.days + 1) %}{% set x = L + step * (d - 0.5) %}
        <line class="tickl" x1="{{ '%.1f'|format(x) }}" x2="{{ '%.1f'|format(x) }}" y1="10" y2="{{ base }}"/>
        {% if d == 1 or d % 5 == 0 %}<text class="day" x="{{ '%.1f'|format(x) }}" y="{{ H - 8 }}" text-anchor="middle">{{ d }}</text>{% endif %}
        {% set day = month ~ '-' ~ ('%02d'|format(d)) %}
        {% for e in viz.events if e.day == day %}
          <rect class="ev" style="--d:{{ d }};--s:{{ loop.index0 }}" x="{{ '%.1f'|format(x - step * 0.36) }}" y="{{ base - 16 * loop.index }}" width="{{ '%.1f'|format(step * 0.72) }}" height="13" fill="{{ colors[e.kind] }}"><title>{{ e.day }} {{ kname[e.kind] }}: {{ e.title }}</title></rect>
        {% endfor %}
      {% endfor %}
      <line class="axis" x1="{{ L }}" x2="{{ W - R }}" y1="{{ base + 1 }}" y2="{{ base + 1 }}"/>
      <line class="scan" x1="{{ L }}" x2="{{ L }}" y1="6" y2="{{ base }}"/>
    </svg>
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} · {{ period.tag }}</span><span class="s-num"></span></footer>
</section>

{{ b.summary_slide('02') }}

<section class="slide" data-title="이달의 키워드">
  <header class="s-head"><div class="s-kicker">03</div><h2 class="rv">이달의 키워드</h2>
    <p class="s-desc rv">서로 다른 보도에서 두 번 이상 다뤄진 말입니다.</p></header>
  <div class="s-body">
  {% if gate.sections.keywords.status == 'ok' %}
  {% set kmax = (keywords|map(attribute='n_clusters')|max) if keywords else 1 %}
  <ul class="kbars">{% for k in keywords %}<li class="kbar rv" style="--i:{{ loop.index0 }};--w:{{ '%.3f'|format(k.n_clusters / kmax) }}"><div class="t">{{ k.term }}<small>관련 보도 <span class="mono" data-count="{{ k.n_clusters }}">{{ k.n_clusters }}</span>건{% if agg.keywords.has_prev %} · 전월 {{ k.n_prev }}건{% endif %}</small></div>
    <div><div class="track"><div class="val"></div></div><p>{{ b.kw_explain(k) }}</p></div></li>{% endfor %}</ul>
  {% else %}{{ b.reduced('keywords') }}{% endif %}
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} · {{ period.tag }}</span><span class="s-num"></span></footer>
</section>

{{ b.search_slide('04', ['var(--k-market)','var(--k-launch)','var(--k-reg)','var(--k-comp)']) }}

{% if viz.notes %}{% set nmax = viz.notes|map(attribute='count')|max %}
<section class="slide" data-title="향 노트 순위">
  <header class="s-head"><div class="s-kicker">05</div><h2 class="rv">향 노트 순위</h2>
    <p class="s-desc rv">향 노트를 밝힌 제품 {{ agg.notes.n }}개 가운데 노트별로 몇 개 제품에 쓰였는지 셌습니다.</p></header>
  <div class="s-body">
    <ol class="rank stage">{% for n in viz.notes[:14] %}<li style="--i:{{ loop.index0 }};--w:{{ '%.3f'|format(n.count / nmax) }}"><span class="no">{{ '%02d'|format(loop.index) }}</span><span>{{ n.note }}</span><span class="tr"><i></i></span><span class="ct">{{ n.count }}개</span></li>{% endfor %}</ol>
  </div>
  <footer class="s-foot"><span>{{ cfg.title }} · {{ period.tag }}</span><span class="s-num"></span></footer>
</section>
{% endif %}
{{ b.notes_table_slides('05') }}
{{ b.launch_slides('06') }}
{{ b.market_slides('07') }}
{{ b.reg_slides('08') }}
{{ b.calendar_slide('10') }}

<!--SOURCE_SLIDES-->
</main>
{{ b.deck_ui() }}
<script>{% include "motion/_deck.js" %}</script>
</body>
</html>
